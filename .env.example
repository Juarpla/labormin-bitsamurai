# Copy to .env and fill in what you have. Everything works without these.

# Google AdSense publisher id. Keep it consistent with public/ads.txt.
# Real units also require a numeric placement mapping from the AdSense account.
# Accepts pub-XXXXXXXXXXXXXXXX or ca-pub-XXXXXXXXXXXXXXXX (the ca- prefix is added if missing).
# PUBLIC_ADSENSE_CLIENT=pub-XXXXXXXXXXXXXXXX
# PUBLIC_ADSENSE_SLOTS={}
# Map placement names (e.g. jobs-top-1) to real numeric ad-unit IDs as strings.
# Unmapped placements stay labeled placeholders; never use made-up IDs.

# Optional ingest source (free tier): https://developer.adzuna.com
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Multi-provider LLM chain (src/lib/llm.js) — auto-translates job titles at
# ingest and powers the on-demand description clear-view API (/api/translate-
# description). Failover is one attempt per provider in this order; providers
# without credentials are skipped.
# LLM_PROVIDER_ORDER=            # optional; default: MISTRAL_MODEL,WORKERS_AI_MODEL,OPENCODE_GO_MODEL
# MISTRAL_API_KEY=               # https://console.mistral.ai (MISTRAL_MODEL, default codestral-2508)
# CLOUDFLARE_ACCOUNT_ID=         # CF dashboard → account id
# CLOUDFLARE_API_TOKEN=          # token with Workers AI: Edit (WORKERS_AI_MODEL, default @cf/qwen/qwen3-30b-a3b-fp8)
# OPENCODE_GO_API_KEY=           # https://opencode.ai/auth — OpenCode Go plan (OPENCODE_GO_MODEL, default mimo-v2.5)
