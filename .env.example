# Copy to .env and fill in what you have. Everything works without these.

# Google AdSense publisher id. Keep it consistent with public/ads.txt.
# Real units also require a numeric placement mapping from the AdSense account.
# Accepts pub-XXXXXXXXXXXXXXXX or ca-pub-XXXXXXXXXXXXXXXX (the ca- prefix is added if missing).
# PUBLIC_ADSENSE_CLIENT=pub-XXXXXXXXXXXXXXXX
# Serving stays off by default. Keep false until a certified CMP is published
# and accept/reject/revoke have been verified. Meta + ads.txt verify ownership.
# PUBLIC_ADSENSE_ENABLED=false
# PUBLIC_ADSENSE_SLOTS={}
# Map placement names (e.g. jobs-top-1) to real numeric ad-unit IDs as strings.
# Unmapped placements stay labeled placeholders; never use made-up IDs.

# Optional ingest source (free tier): https://developer.adzuna.com
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Vista clara and English titles are prepared together after the catalog refresh.
# LLM_PROVIDER_ORDER=AGNES_MODEL,OPENCODE_GO_MODEL,WORKERS_AI_MODEL,MISTRAL_MODEL
# JOB_PRESENTATION_MAX_CALLS=30    # 0 pauses provider calls; maximum 120
# AGNES_API_KEY=                   # https://platform.agnes-ai.com
# AGNES_MODEL=agnes-3.0-flash
# OPENCODE_GO_API_KEY=             # https://opencode.ai/auth
# OPENCODE_GO_MODEL=mimo-v2.6-flash
# CLOUDFLARE_ACCOUNT_ID=           # account ID
# CLOUDFLARE_API_TOKEN=            # Workers AI: Edit
# WORKERS_AI_MODEL=@cf/qwen/qwen3.8-27b
# MISTRAL_API_KEY=                  # https://console.mistral.ai
# MISTRAL_MODEL=codestral-2508

# Application guidance uses its own order and limit. See ARCHITECTURE.md §7.
# JOB_GUIDANCE_PROVIDER_ORDER=AGNES_MODEL,OPENCODE_GO_MODEL,WORKERS_AI_MODEL,MISTRAL_MODEL
# JOB_GUIDANCE_MAX_CALLS=30       # 0 pauses the batch; hard maximum 120
