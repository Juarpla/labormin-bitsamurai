---
import GuideIcon from './GuideIcon.astro';
import type { CatalogEntry } from '../../lib/catalog-data';

type Props = CatalogEntry<'guides'>;
const { slug, metadata } = Astro.props;
---
<a href={`/guias/${slug}/`} class="group grid h-full grid-cols-[auto_minmax(0,1fr)] content-start items-start gap-x-3 gap-y-2 rounded-2xl border border-graphite-700 bg-graphite-900 p-5 transition-colors hover:border-brand-500/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-400">
  <span class="grid size-9 place-items-center rounded-lg bg-brand-500/10 text-brand-400 [&_svg]:size-6"><GuideIcon kind={metadata.icon} /></span>
  <h3 class="self-center text-pretty font-display text-lg font-semibold leading-snug text-graphite-100 group-hover:text-brand-400 group-focus-visible:text-brand-400">{metadata.title}</h3>
  <p class="col-start-2 text-sm leading-relaxed text-graphite-200">{metadata.description}</p>
  <span class="col-start-2 text-brand-400" aria-hidden="true">→</span>
</a>
