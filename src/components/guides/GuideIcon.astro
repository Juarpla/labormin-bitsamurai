---
interface Props { kind: 'cost' | 'practice' | 'credential' | 'time' | 'travel' | 'materials'; }
const {kind} = Astro.props;
---
<svg class="guide-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
  {kind === 'cost' && <><path d="M5 9V6h20v5M5 9h23v17H5V9Z"/><path d="M23 15h5v6h-5a3 3 0 0 1 0-6Z"/><path d="M10 14h5m-5 5h3"/></>}
  {kind === 'practice' && <><path d="M5 26V15l7 4V9l8 6V6h7v20H5Z"/><path d="M11 24v-2m6 2v-2m6 2v-2M20 10h7"/></>}
  {kind === 'credential' && <><rect x="7" y="4" width="18" height="23" rx="2"/><path d="M12 10h8m-8 5h5m0 6 3-2 3 2v8l-3-2-3 2v-8Z"/></>}
  {kind === 'time' && <><rect x="4" y="7" width="24" height="21" rx="3"/><path d="M10 4v6m12-6v6M4 14h24m-16 6 3 3 6-6"/></>}
  {kind === 'travel' && <><rect x="6" y="4" width="20" height="22" rx="4"/><path d="M6 16h20M10 9h12m-11 12h1m8 0h1M10 26v3m12-3v3"/></>}
  {kind === 'materials' && <><path d="m7 24 14-14m-7 0 8-6 6 6-6 8-8-8ZM5 23l4 4-4 2-2-2 2-4Z"/><path d="m18 7 7 7M4 5l5 1 1 5-2 2-5-5 1-3Zm6 6 3 3m7 7 7 7"/></>}
</svg>
<style>.guide-icon{width:32px;height:32px;flex-shrink:0;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}</style>
