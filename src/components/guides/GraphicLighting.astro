---
interface Props { id: string; width: number; height: number }
const { id, width, height } = Astro.props;
---
<!-- Tonal graphite with restrained borders and a clipped texture. -->
<defs>
  <linearGradient id={`${id}-surface`} x2="0" y2="1">
    <stop stop-color="#232c3b"/><stop offset="1" stop-color="#141a24"/>
  </linearGradient>
  <clipPath id={`${id}-bounds`}><rect x="4" y="4" width={width - 8} height={height - 8} rx="10"/></clipPath>
  <filter id={`${id}-grain`}>
    <feTurbulence baseFrequency=".56" numOctaves="2" seed="31" type="fractalNoise" stitchTiles="stitch"/>
    <feColorMatrix type="saturate" values="0"/>
  </filter>
</defs>
