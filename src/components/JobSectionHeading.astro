---
interface Props {
  id?: string;
  step?: number;
}
const { id, step } = Astro.props;
---
<h2 id={id} class:list={['font-display text-2xl font-semibold text-graphite-100', step && 'flex items-start gap-3']}>
  {step && (
    <span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-lg border border-brand-500/30 bg-brand-500/10 font-sans text-sm font-semibold tabular-nums text-brand-400" aria-hidden="true">{step}</span>
  )}
  <span><slot /></span>
</h2>
