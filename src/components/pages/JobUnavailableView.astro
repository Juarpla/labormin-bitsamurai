---
interface Props {
  heading?: string;
}

const { heading = 'Convocatoria no disponible' } = Astro.props;
---

<section data-job-unavailable class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-20" aria-labelledby="job-unavailable-title">
  <div class="rounded-2xl border border-graphite-800 bg-graphite-900 p-6 sm:p-10">
    <svg class="mb-5 size-7 text-graphite-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </svg>
    <h1 id="job-unavailable-title" class="max-w-lg font-display text-3xl font-semibold leading-tight text-balance text-graphite-100 sm:text-4xl">{heading}</h1>
    <p class="mt-3 max-w-lg leading-relaxed text-graphite-200">Consulta las convocatorias abiertas en el catálogo de Labormin.</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/jobs/" class="inline-flex min-h-11 items-center rounded-full bg-brand-500 px-5 text-sm font-semibold text-graphite-950 hover:bg-brand-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-400">Ver empleos vigentes</a>
      <a href="/practicas/" class="inline-flex min-h-11 items-center rounded-full border border-graphite-600 px-5 text-sm font-semibold text-graphite-100 hover:border-brand-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-400">Ver prácticas vigentes</a>
    </div>
  </div>
  <section class="mt-8 sm:mt-10" aria-labelledby="next-application-title">
    <h2 id="next-application-title" class="font-display text-xl font-semibold text-graphite-100 sm:text-2xl">Prepara tu próxima postulación</h2>
    <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <li><a href="/guias/cv-minero-sin-experiencia/" class="inline-block py-2 text-graphite-200 underline underline-offset-4 hover:text-brand-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-400">Arma tu CV minero</a></li>
      <li><a href="/formacion/" class="inline-block py-2 text-graphite-200 underline underline-offset-4 hover:text-brand-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-400">Busca opciones de formación</a></li>
      <li><a href="/guias/trabajar-en-mina-sin-experiencia/" class="inline-block py-2 text-graphite-200 underline underline-offset-4 hover:text-brand-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-400">Explora cómo ganar experiencia</a></li>
    </ul>
  </section>
</section>
