---
import Chapter from '../Chapter.astro';
import JobCard from '../JobCard.astro';
import AdSlot from '../AdSlot.astro';
import JobDrawer from '../JobDrawer.astro';
import SectorPulse from '../SectorPulse.astro';
import StocksPulse from '../StocksPulse.astro';
import { useTranslations, localePath, type Locale } from '../../lib/i18n';
import { jobIndex } from '../../lib/jobs';
import { openCatalog } from '../../lib/catalog';
import { catalogNow, isActiveJobRow } from '../../lib/catalog-data';
import { isExpired } from '../../lib/job-policy.mjs';
import { upcomingEvents } from '../../lib/events';
import { education, trainingGuidePath } from '../../lib/education';

interface Props {
  locale?: Locale;
  path?: string;
}
const { locale = 'es' } = Astro.props;
const t = useTranslations(locale);

// Nicho fijo: Perú (sin detección por IP ni selectores).
const now = catalogNow();
const at = now.toISOString();
const catalog = await openCatalog('jobs', undefined, at);
const active = catalog.entries.filter(({ metadata }) => isActiveJobRow(metadata, at));
const employments = active.filter(({ metadata }) => metadata.type === 'job');
const inPeru = employments.filter(({ metadata }) => metadata.country === 'PE').slice(0, 9);
const remoteCandidates = employments.filter(({ metadata }) => metadata.remote && metadata.remoteFromPeru !== false);
const remoteEntries = remoteCandidates.some(({ metadata }) => metadata.remoteFromPeru === undefined)
  ? remoteCandidates
  : remoteCandidates.slice(0, 6);
const featuredSlugs = new Set([...inPeru, ...remoteEntries].map(({ slug }) => slug));
const featured = (await catalog.read([...featuredSlugs])).flatMap(({ job }) => job && !isExpired(job, now) ? [job] : []);
const featuredBySlug = new Map(featured.map(job => [job.slug, job]));
const peJobs = inPeru.flatMap(({ slug }) => featuredBySlug.get(slug) ?? []);
const heroJobs = peJobs.slice(0, 3); // el arranque muestra lo más fresco
const peChapterJobs = peJobs.slice(3, 9); // el capítulo continúa donde el hero termina
const remotes = remoteEntries.flatMap(({ slug }) => featuredBySlug.get(slug) ?? [])
  .filter(job => job.remoteEligibility.status === 'peru-supported').slice(0, 6);
const index = jobIndex(locale, featured);
const catalogTotals = [
  { label: 'Empleos', count: employments.length, path: '/jobs' },
  { label: 'Prácticas', count: active.length - employments.length, path: '/practicas' },
  { label: 'Opciones de formación', count: education.length, path: '/formacion' },
];
const fmtCount = (n: number) => new Intl.NumberFormat('es-PE').format(n);
const feedUpdatedAt = new Intl.DateTimeFormat('es-PE', { dateStyle: 'long' }).format(
  new Date(catalog.revision ?? at)
);

// Eventos mineros próximos (curados a mano)
const events = upcomingEvents().slice(0, 3);
const fmtEventDate = (iso: string) =>
  new Intl.DateTimeFormat('es-PE', { dateStyle: 'long' }).format(new Date(iso));

const payload = JSON.stringify({
  locale,
  index,
  msgs: {
    quick: t('drawer.quick'),
    full: t('drawer.full'),
    apply: t('drawer.apply'),
  },
});
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_50%_at_50%_0%,rgba(245,166,35,0.13),transparent_70%)]"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-6xl px-4 pb-16 pt-14 sm:px-6 sm:pb-20 sm:pt-16 lg:pb-28 lg:pt-24">
    <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
      <div>
        <h1 class="max-w-2xl font-display text-4xl font-semibold leading-[1.08] tracking-tight text-balance text-graphite-100 sm:text-5xl xl:text-6xl">
          {t('hero.title')}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-graphite-200">{t('hero.subtitle')}</p>

        <ul class="mt-8 grid max-w-xl grid-cols-3 divide-x divide-graphite-700" aria-label="Totales del catálogo">
          {catalogTotals.map(({ label, count, path }) => (
            <li class="min-w-0 px-3 first:pl-0 last:pr-0 sm:px-5">
              <a href={localePath(locale, path)} class="group block rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-400">
                <span class="block font-display text-3xl font-semibold tabular-nums text-graphite-100">{fmtCount(count)}</span>
                <span class="mt-1 block text-sm leading-snug text-graphite-200 group-hover:text-brand-400">{label}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-graphite-400">Empleos y prácticas actualizados el {feedUpdatedAt}</p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href={localePath(locale, '/jobs')}
            class="rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-graphite-950 transition-colors hover:bg-brand-400"
          >
            {t('hero.cta')}
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="font-display text-base font-semibold text-graphite-100">{t('hero.fresh.title')}</h2>
          <a
            href={localePath(locale, '/jobs')}
            class="shrink-0 text-xs font-semibold text-brand-400 transition-colors hover:text-brand-300"
          >
            {t('common.viewAll')} →
          </a>
        </div>
        {heroJobs.map((job) => <JobCard job={job} locale={locale} />)}
      </div>
    </div>
  </div>
</section>

{peChapterJobs.length > 0 && (
<Chapter kicker={t('chapter.inCountry.kicker')} title={t('chapter.inCountry.title')} lead={t('chapter.inCountry.lead')} id="chapter-pe-section">
  <div class="grid gap-4 sm:grid-cols-2">
    {peChapterJobs.map((job) => <JobCard job={job} locale={locale} />)}
  </div>
  <a href={localePath(locale, '/jobs')} class="mt-6 inline-block text-sm font-semibold text-brand-400 hover:text-brand-300">
    {t('common.viewAll')} →
  </a>
</Chapter>
)}

<SectorPulse locale={locale} active={employments.length} />

<StocksPulse locale={locale} />

<Chapter kicker={t('chapter.events.kicker')} title={t('chapter.events.title')} lead={t('chapter.events.lead')}>
  <div class="grid gap-4 sm:grid-cols-3">
    {
      events.map((e) => (
        <article class="flex flex-col gap-2 rounded-2xl border border-graphite-800 bg-graphite-900 p-5">
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-500">{e.mode === 'presencial' ? 'Presencial' : 'Virtual'} · {e.city ?? ''}</p>
          <h3 class="font-display text-base font-semibold leading-snug text-graphite-100">{e.title}</h3>
          <p class="text-xs text-graphite-400">📅 {fmtEventDate(e.date)}</p>
          <a
            href={e.officialUrl}
            target="_blank"
            rel="noopener nofollow"
            class="mt-auto text-xs font-semibold text-brand-400 hover:text-brand-300"
          >
            {t('events.official')} ↗
          </a>
        </article>
      ))
    }
  </div>
  <a href={localePath(locale, '/eventos')} class="mt-6 inline-block text-sm font-semibold text-brand-400 hover:text-brand-300">
    {t('common.viewAll')} →
  </a>
</Chapter>

<AdSlot slotId="home-spotlight-1" format="fluid" layoutKey="-fb+5w+4e-db+86" locale={locale} />

<Chapter kicker={t('chapter.remote.kicker')} title={t('chapter.remote.title')} lead={t('chapter.remote.lead')} full>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {remotes.length === 0 && <p class="max-w-xl text-sm leading-relaxed text-graphite-200">Todavía no hemos confirmado ofertas remotas compatibles con trabajar desde Perú en este catálogo. Consulta <a href="/guias/verificar-oferta-remota-visa-salario" class="text-brand-400 underline">cómo verificar los países admitidos</a>.</p>}
    {remotes.map((job) => <JobCard job={job} locale={locale} variant="compact" />)}
  </div>
  <a
    href={`${localePath(locale, '/jobs')}?type=remote`}
    class="mt-6 inline-block text-sm font-semibold text-brand-400 hover:text-brand-300"
  >
    {t('common.viewAll')} →
  </a>
</Chapter>

<AdSlot slotId="home-remote-1" format="auto" locale={locale} />

<section aria-labelledby="applicant-kit-title" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
  <h2 id="applicant-kit-title" class="font-display text-3xl font-semibold leading-tight text-graphite-100 sm:text-4xl">
    {t('chapter.guides.kicker')}
  </h2>
  <p class="mt-3 max-w-xl leading-relaxed text-graphite-400">
    Prepara tu primera postulación o averigua qué necesitas para dar el siguiente paso.
  </p>
  <div class="mt-8 grid gap-4 md:grid-cols-3">
    <a
      href={localePath(locale, '/guias')}
      class="group flex flex-col gap-2 rounded-2xl border border-graphite-800 bg-graphite-900 p-6 transition-colors hover:border-brand-500"
    >
      <h3 class="font-display text-lg font-semibold text-graphite-100 group-hover:text-brand-400">{t('nav.guias')}</h3>
      <p class="text-sm text-graphite-400">Prepara tu CV, explora prácticas y compara sueldos, turnos y condiciones.</p>
    </a>
    <a href={localePath(locale, trainingGuidePath)} class="group flex flex-col gap-2 rounded-2xl border border-graphite-800 bg-graphite-900 p-6 transition-colors hover:border-brand-500">
      <h3 class="font-display text-lg font-semibold text-graphite-100 group-hover:text-brand-400">Formación con poco presupuesto</h3>
      <p class="text-sm text-graphite-400">Cursos gratuitos, CETPRO e institutos públicos en Perú: compara el costo total y la credencial.</p>
    </a>
    <a
      href={localePath(locale, '/faq')}
      class="group flex flex-col gap-2 rounded-2xl border border-graphite-800 bg-graphite-900 p-6 transition-colors hover:border-brand-500"
    >
      <h3 class="font-display text-lg font-semibold text-graphite-100 group-hover:text-brand-400">Preguntas frecuentes</h3>
      <p class="text-sm text-graphite-400">{t('faq.teaser')}</p>
    </a>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 pb-32 sm:px-6">
  <div class="reveal rounded-3xl border border-brand-600/40 bg-gradient-to-b from-brand-500/10 to-transparent p-10 text-center sm:p-16">
    <h2 class="font-display text-3xl font-semibold text-graphite-100 sm:text-5xl">{t('chapter.cta.title')}</h2>
    <p class="mx-auto mt-4 max-w-xl text-graphite-400">{t('chapter.cta.body')}</p>
    <a
      href={localePath(locale, '/jobs')}
      class="mt-8 inline-block rounded-full bg-brand-500 px-8 py-4 text-sm font-semibold text-graphite-950 transition-colors hover:bg-brand-400"
    >
      {t('chapter.cta.button')}
    </a>
  </div>
</section>

<JobDrawer locale={locale} />

<script type="application/json" id="lm-data" set:html={payload.replace(/</g, '\\u003c')} />

<script>
  // Solo el drawer necesita el índice de empleos (las tarjetas ya son estáticas).
  const data = JSON.parse(document.getElementById('lm-data')!.textContent!);
  window.__lmIndex = data.index;
</script>
