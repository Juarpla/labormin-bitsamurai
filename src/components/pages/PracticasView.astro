---
import CatalogPagination from '../CatalogPagination.astro';
import { paginate, resultRange, searchText } from '../../lib/pagination';
import { openCatalog } from '../../lib/catalog';
import { catalogNow } from '../../lib/catalog-data';
import AdSlot from '../AdSlot.astro';
import JobCard from '../JobCard.astro';
import JobFilters from '../JobFilters.astro';
import JobDrawer from '../JobDrawer.astro';
import { localePath, useTranslations, type Locale } from '../../lib/i18n';
import { jobIndex } from '../../lib/jobs';

interface Props {
  locale?: Locale;
}
const { locale = 'es' } = Astro.props;
const t = useTranslations(locale);

const params = Astro.url.searchParams;
const q = searchText((params.get('q') ?? '').slice(0, 120));
const catalog = await openCatalog('jobs', 'internship');
const now = catalogNow().toISOString();
const available = catalog.entries.filter(({ metadata }) => metadata.type === 'internship' && (!metadata.closesAt || metadata.closesAt > now));
const filtered = available.filter(({ metadata: job }) => {
  const country = params.get('country');
  const category = params.get('category');
  const type = params.get('type');
  const tier = params.get('tier');
  return (!country || job.country === country) &&
    (!category || job.category === category) &&
    (type !== 'remote' && type !== 'onsite' || job.remote === (type === 'remote')) &&
    (tier !== 'pe' && tier !== 'remote' || job.tier === (tier === 'pe' ? 1 : 2)) &&
    (!q || job.search.includes(q));
});
const page = paginate(filtered, Astro.url);
const jobs = (await catalog.read(page.items.map(item => item.slug))).flatMap(row => row.job ? [row.job] : []);
const payload = JSON.stringify({ index: jobIndex(locale, jobs) });

---

<div class="xl:grid xl:grid-cols-[160px_56rem_160px] xl:justify-center xl:gap-4">
  <AdSlot
    slotId="practicas-side-1"
    size={{ w: 160, h: 600 }}
    media="(min-width: 1280px)"
    locale={locale}
    class="sticky top-24 hidden w-fit self-start xl:col-start-1 xl:row-start-1 xl:block"
  />
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 xl:col-start-2 xl:row-start-1">
    <h1 class="font-display text-4xl font-semibold text-graphite-100 sm:text-5xl">{t('practicas.title')}</h1>
    <p class="mt-4 max-w-2xl text-graphite-400">{t('practicas.lead')}</p>

    <AdSlot
      slotId="practicas-top-1"
      size={{ w: 320, h: 50 }}
      media="(max-width: 1023.98px)"
      locale={locale}
      class="mx-auto w-fit lg:hidden"
    />

    <JobFilters jobs={available.map(item => item.metadata)} locale={locale} />
    <p id="resultados" class="mt-6 scroll-mt-28 text-sm text-graphite-300">Prácticas: {resultRange(page)}</p>

    <div id="jobs-grid" class="mt-4 grid gap-4 sm:grid-cols-2">
      {jobs.map(job => <JobCard job={job} locale={locale} />)}
    </div>

    <CatalogPagination page={page} anchor="resultados" label="Páginas de prácticas" />

  <div id="jobs-empty" class:list={['mt-10', { hidden: page.total > 0 }]}>
      {available.length ? (
        <div class="rounded-2xl border border-graphite-800 p-8 text-center">
          <h2 class="font-display text-2xl font-semibold text-graphite-100">No hay prácticas con estos filtros</h2>
          <a id="f-clear-empty" href={`${Astro.url.pathname}#resultados`} class="mt-4 rounded-full border border-graphite-700 px-4 py-2 text-sm hover:text-brand-400">{t('jobs.clear')}</a>
        </div>
      ) : (
        <div class="rounded-2xl border border-graphite-800 p-8 text-center">
          <h2 class="font-display text-2xl font-semibold text-graphite-100">{t('practicas.empty.title')}</h2>
          <p class="mx-auto mt-3 max-w-sm text-sm leading-relaxed text-graphite-300">{t('practicas.empty.body')}</p>
          <a class="mt-4 inline-block text-sm font-semibold text-brand-400 hover:underline" href={localePath(locale, '/jobs')}>{t('practicas.empty.jobs')}</a>
        </div>
      )}
    </div>

    <a
      href="/guias/practicas-mineras-peru/"
      class="mt-8 inline-block rounded-sm text-sm font-semibold text-brand-400 transition-colors hover:text-brand-300 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-graphite-950"
    >
      Cómo elegir una práctica minera →
    </a>
  </section>

  <AdSlot
    slotId="practicas-side-2"
    size={{ w: 160, h: 600 }}
    media="(min-width: 1280px)"
    locale={locale}
    class="sticky top-24 hidden w-fit self-start xl:col-start-3 xl:row-start-1 xl:block"
  />
</div>

<div class="pb-4">
  <AdSlot
    slotId="practicas-bottom-desktop-1"
    size={{ w: 970, h: 90 }}
    media="(min-width: 1024px)"
    locale={locale}
    class="mx-auto w-fit hidden lg:block"
  />
  <AdSlot
    slotId="practicas-bottom-mobile-1"
    size={{ w: 320, h: 100 }}
    media="(max-width: 1023.98px)"
    locale={locale}
    class="mx-auto w-fit lg:hidden"
  />
</div>

<JobDrawer locale={locale} />

<script type="application/json" id="lm-jobs-data" set:html={payload.replace(/</g, '\\u003c')} />

<script>
  const data = JSON.parse(document.getElementById('lm-jobs-data')!.textContent!);
  (window as any).__lmIndex = data.index;
</script>
