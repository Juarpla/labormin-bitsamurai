---
import { sectionLabels } from '../../lib/job-presentation.mjs';
import { jobPosting } from '../../lib/job-policy.mjs';
import type { Job } from '../../schemas';
import JobApplicationGuide from '../JobApplicationGuide.astro';
import JobCard from '../JobCard.astro';
import { useTranslations, type Locale } from '../../lib/i18n';
import { formatSalary, formatDate, relatedJobs, titleFor, isAutoTranslated, clearViewFor, locationLine } from '../../lib/jobs';

interface Props {
  job: Job;
  locale?: Locale;
}
const { job, locale = 'es' } = Astro.props;
const t = useTranslations(locale);
const related = relatedJobs(job, 3);
const backHref = locale === 'es' ? '/jobs' : `/${locale}/jobs`;
const clearView = clearViewFor(job);

const jsonLd = jobPosting(job);
const categoryLabels: Record<string, string> = { operations: 'Operaciones', maintenance: 'Mantenimiento', engineering: 'Ingeniería', geology: 'Geología', hse: 'Seguridad y ambiente', processing: 'Procesamiento', exploration: 'Exploración', other: 'Empleo minero' };
const sourceHost = new URL(job.url).hostname.replace(/^www\./, '');
---

<article class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
  <nav class="text-sm text-graphite-400" aria-label="Breadcrumb">
    <a href={backHref} class="hover:text-brand-400">← {t('common.back')}</a>
  </nav>

  <header class="mt-6">
    <div class="flex flex-wrap items-center gap-2 text-xs text-graphite-400">
      <span class="rounded-full bg-graphite-800 px-2.5 py-1">{categoryLabels[job.category] || 'Empleo minero'}</span>
      <span class="break-all rounded-full bg-graphite-800 px-2.5 py-1">{sourceHost}</span>
      {job.remote && <span class="rounded-full bg-graphite-800 px-2.5 py-1 text-brand-300">↗ {t('card.remote')}</span>}
      {job.openToInternational && (
        <span class="rounded-full border border-brand-600/60 bg-brand-500/10 px-2.5 py-1 text-brand-400">✦ {t('card.international')}</span>
      )}
      <time datetime={job.publishedAt || job.postedAt}>{job.publishedAt ? 'Publicado' : 'Fecha de referencia'} {formatDate(job.publishedAt || job.postedAt, locale)}</time>
    </div>
    <h1 class="mt-4 font-display text-3xl font-semibold leading-tight text-graphite-100 sm:text-4xl">
      {titleFor(job, locale)}
    </h1>
    {isAutoTranslated(job, locale) && (
      <p class="mt-2 text-sm text-graphite-400">
        <span class="mr-2 inline-block rounded-full border border-graphite-700 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-graphite-500">
          ✦ {t('job.autoTranslated')}
        </span>
        <span class="italic">“{job.title}”</span>
      </p>
    )}
    <p class="mt-3 text-lg text-graphite-200">
      <span class="font-medium">{job.company}</span>
      <span class="text-graphite-400"> · {locationLine(job, t)}</span>
    </p>
    {job.salary && (
      <p class="mt-2 text-sm font-semibold text-brand-400">{formatSalary(job)}</p>
    )}

    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={job.url}
        target="_blank"
        rel="noopener nofollow"
        class="rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-graphite-950 transition-colors hover:bg-brand-400"
      >
        {t('drawer.apply')} ↗
      </a>
      {job.visaReported && (
        <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-600/60 bg-brand-500/10 px-4 py-3 text-xs font-medium text-brand-400">
          ✦ {t('card.visa')}
        </span>
      )}
      {job.openToInternational && !job.visaReported && (
        <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-600/60 bg-brand-500/10 px-4 py-3 text-xs font-medium text-brand-400">
          ✦ {t('card.international')}
        </span>
      )}
    </div>
  </header>

  {(job.visaReported || job.openToInternational) && (
    <p class="mt-6 rounded-xl border border-graphite-700 bg-graphite-900 p-4 text-sm text-graphite-400">
      ℹ {t('drawer.visaNote')}
    </p>
  )}

  <aside class="mt-6 space-y-3 rounded-xl border border-graphite-700 bg-graphite-900 p-4 text-sm leading-relaxed text-graphite-200" aria-label="Alcance de la información">
    <p>{job.descriptionStatus === 'full' ? 'Texto completo obtenido del anuncio original.' : job.descriptionStatus === 'unknown' ? 'No hemos verificado si el texto obtenido está completo. Consulta el anuncio original antes de postular.' : 'Extracto obtenido de la fuente. Puede omitir condiciones; consulta el anuncio original antes de postular.'} Labormin automatiza la importación; la vigencia y los requisitos se confirman con el empleador.</p>
    {job.fetchedAt && <p class="text-xs text-graphite-400">Texto consultado el {formatDate(job.fetchedAt, locale)}. Esta fecha no garantiza que la convocatoria siga abierta.</p>}
    {job.validThrough && <p class="text-xs text-graphite-400">Cierre indicado por la fuente: {formatDate(job.validThrough, locale)}. Verifica posibles cambios en el anuncio.</p>}
    {job.remote && <p>{job.remoteEligibility.status === 'peru-supported' ? 'La fuente contiene una señal compatible con trabajar desde Perú. Confirma la contratación y tus condiciones con el empleador.' : 'La modalidad remota no confirma que se pueda trabajar desde Perú.'}</p>}
    {job.remoteEligibility.evidence.map(e => <blockquote class="break-words border-l-2 border-graphite-600 pl-3 text-xs text-graphite-400">{e}</blockquote>)}
    {job.visa.status === 'authorization-required' && <p>La fuente exige autorización laboral; esa condición no demuestra patrocinio de visa.</p>}
    {job.visa.status === 'not-offered' && <p>El texto indica que no se ofrece patrocinio para esta vacante.</p>}
    {job.visa.evidence.map(e => <blockquote class="break-words border-l-2 border-graphite-600 pl-3 text-xs text-graphite-400">{e}</blockquote>)}
    {job.salary && <details><summary class="cursor-pointer">Redacción salarial de la fuente</summary><p class="mt-2 break-words text-xs text-graphite-400">{job.salary.raw}</p></details>}
    <a href={job.url} target="_blank" rel="noopener nofollow" class="inline-block text-brand-400 hover:underline">Consultar el anuncio original ↗</a>
    <a href="/about#metodologia" class="ml-4 inline-block text-brand-400 hover:underline">Cómo seleccionamos las ofertas</a>
  </aside>

  <section class="mt-10" aria-labelledby="job-description-title">
    <h2 id="job-description-title" class="font-display text-2xl font-semibold text-graphite-100">
      {clearView.sections.length ? 'Vista clara' : 'Texto disponible de la fuente'}
    </h2>
    {clearView.sections.length ? (
      <>
        <p class="mt-2 text-sm leading-relaxed text-graphite-400">
          {clearView.generated
            ? 'Organizada con IA a partir del anuncio. Verifica las condiciones con el empleador.'
            : 'Texto de la fuente, organizado para facilitar la lectura.'}
          {job.descriptionStatus === 'source-extract' && ' Se muestra el extracto disponible.'}
        </p>
        <div data-job-clear-view class="mt-5 space-y-5 break-words">
          {clearView.sections.map(({ heading, blocks }) => (
            <div>
              {(clearView.sections.length > 1 || heading !== 'overview') && (
                <h3 class="mb-2 font-display text-lg font-semibold text-graphite-100">{sectionLabels[heading]}</h3>
              )}
              {blocks.length > 1 && (heading === 'duties' || heading === 'requirements') ? (
                <ul class="list-disc space-y-2 pl-5 text-base leading-relaxed text-graphite-200 marker:text-graphite-500">
                  {blocks.map(block => <li>{block}</li>)}
                </ul>
              ) : (
                <div class="space-y-2 text-base leading-relaxed text-graphite-200">
                  {blocks.map(block => <p>{block}</p>)}
                </div>
              )}
            </div>
          ))}
        </div>
        <details class="mt-5 rounded-xl border border-graphite-700 bg-graphite-900 p-4">
          <summary class="cursor-pointer text-sm font-medium text-brand-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-400">
            Ver texto original
          </summary>
          <div data-job-original class="mt-4 max-w-none space-y-4 break-words text-base leading-relaxed text-graphite-200 [&_a]:text-brand-400">
            <Fragment set:html={job.description} />
          </div>
        </details>
      </>
    ) : (
      <div data-job-original class="mt-4 space-y-4 break-words text-base leading-relaxed text-graphite-200 [&_a]:text-brand-400">
        <Fragment set:html={job.description} />
      </div>
    )}
  </section>

  <JobApplicationGuide job={job} />

  <div class="mt-10">
    <a
      href={job.url}
      target="_blank"
      rel="noopener nofollow"
      class="inline-block rounded-full border border-graphite-600 px-6 py-3 text-sm font-semibold text-graphite-100 transition-colors hover:border-brand-500"
    >
      {t('drawer.apply')} ↗
    </a>
  </div>


  {related.length > 0 && (
    <section class="mt-16">
      <h2 class="font-display text-2xl font-semibold text-graphite-100">{t('common.related')}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((r) => <JobCard job={r} locale={locale} />)}
      </div>
    </section>
  )}
</article>

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
