---
import JobSectionHeading from './JobSectionHeading.astro';
import JobExperienceGuide from './JobExperienceGuide.astro';
import GuideIcon from './guides/GuideIcon.astro';
import { education } from '../lib/education';
import type { careerGuidance } from '../lib/job-guidance.mjs';
import type { Job } from '../schemas';

interface Props { guide: ReturnType<typeof careerGuidance>; job: Job; tools: string[]; experience?: string }
const { guide, job, tools, experience } = Astro.props;
const training = guide.trainingIds.flatMap((id: string) => education.filter(option => option.id === id));
const preparation = [
  {
    icon: 'credential', title: 'Ajusta tu CV',
    text: experience
      ? `El anuncio menciona «${experience}». En tu CV, destaca los puestos o proyectos que respaldan ese requisito e indica sus fechas.`
      : 'Da prioridad a los puestos, estudios o proyectos que coinciden con las funciones anunciadas.',
  },
  {
    icon: 'practice', title: 'Muestra cómo trabajas',
    text: tools.length
      ? `Si has usado ${tools.slice(0, 3).join(', ')}, prepara un ejemplo. Explica qué entregaste y cómo comprobaste el resultado.`
      : 'Prepara un ejemplo de una tarea afín. Explica qué entregaste y cómo comprobaste el resultado.',
  },
  {
    icon: 'materials', title: 'Prepara la entrevista',
    text: guide.questions[0] || 'Pregunta cómo se evalúa el trabajo y qué resultados esperan durante los primeros meses.',
  },
  {
    icon: 'time', title: 'Verifica las condiciones',
    text: job.remote
      ? 'Confirma desde dónde puedes trabajar, qué horario se espera y si habrá reuniones o viajes presenciales.'
      : `Confirma ${job.city ? `la dirección de la sede en ${job.city}` : 'la sede y la operación'}, el régimen y quién cubre los traslados.`,
  },
  {
    icon: 'cost', title: 'Aclara la remuneración',
    text: job.salary
      ? 'Confirma si el monto publicado es bruto o neto y qué conceptos se pagan por separado.'
      : 'Consulta el monto, la frecuencia de pago y qué gastos cubre la empresa.',
  },
  {
    icon: 'message', title: 'Organiza tu postulación',
    text: job.internship
      ? 'Confirma si aceptan tu condición de estudiante o egresado y qué convenio o constancia debes presentar.'
      : 'Revisa si hay un plazo de cierre y qué documentos pide el formulario. Guarda la confirmación de envío para hacer seguimiento.',
  },
] as const;
const trainingChecks = [
  { icon: 'credential', title: 'Prioriza el requisito', text: 'Identifica qué habilidad es obligatoria y si ya puedes acreditarla con un proyecto o con experiencia.' },
  { icon: 'materials', title: 'Compara los programas', text: 'Revisa el temario, las horas de práctica, el costo total y la credencial que obtendrías.' },
] as const;
---
<section class="mt-10 border-t border-graphite-700 pt-7" aria-labelledby="application-guide-title" data-application-guide>
  <JobSectionHeading id="application-guide-title" step={5}>Prepara tu postulación</JobSectionHeading>
  <p class="mt-2 text-sm text-graphite-300">Usa los datos publicados como punto de partida y confirma las condiciones con el empleador.</p>
  <ol class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
    {preparation.map(step => (
      <li class="grid grid-cols-[2.75rem_minmax(0,1fr)] items-start gap-3.5 rounded-xl border border-graphite-700 bg-graphite-900 p-4 sm:block">
        <div class="flex size-11 items-center justify-center rounded-xl border border-graphite-700 bg-graphite-850 text-brand-400 [&_svg]:size-6">
          <GuideIcon kind={step.icon} />
        </div>
        <div class="pb-1 sm:mt-3">
          <h3 class="font-semibold text-graphite-100">{step.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-graphite-200">{step.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<section class="mt-10 border-t border-graphite-700 pt-7" aria-labelledby="job-training-title" data-guidance-training>
  <JobSectionHeading id="job-training-title" step={6}>¿No tienes las habilidades que te piden?</JobSectionHeading>
  <ul role="list" class="mt-4 grid gap-3 sm:grid-cols-2">
    {trainingChecks.map(({ icon, title, text }) => (
      <li class="flex items-start gap-3 rounded-xl border border-graphite-700 bg-graphite-900 p-4">
        <span class="shrink-0 text-brand-400 [&_svg]:size-5"><GuideIcon kind={icon} /></span>
        <div>
          <h3 class="text-sm font-semibold text-graphite-100">{title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-graphite-200">{text}</p>
        </div>
      </li>
    ))}
  </ul>
  {training.length ? (
    <>
      <h3 class="mt-5 text-sm font-semibold text-graphite-100">Opciones de formación para explorar</h3>
      {guide.skill && <p class="mt-1 text-sm text-graphite-300">Compara programas relacionados con {guide.skill} y opciones cerca de la vacante.</p>}
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {training.map(option => (
          <li class="min-w-0 rounded-xl border border-graphite-700 bg-graphite-850 p-4">
            <div class="flex items-start gap-2.5">
              <span class="text-brand-400 [&_svg]:size-6"><GuideIcon kind="credential" /></span>
              <div>
                <h3 class="font-semibold leading-snug text-graphite-100">{option.title}</h3>
                <p class="mt-0.5 text-sm text-graphite-300">{option.name} · {option.location}</p>
              </div>
            </div>
            <dl class="mt-3 space-y-2 text-sm leading-relaxed text-graphite-200">
              <div class="relative pl-6">
                <dt class="inline font-medium text-graphite-100"><span class="training-meta-icon absolute top-1 left-0 text-brand-400"><GuideIcon kind="cost" /></span>Costo</dt>
                <dd class="ml-1.5 inline">{option.costLabel}. {option.costNote}.</dd>
              </div>
              <div class="relative pl-6">
                <dt class="inline font-medium text-graphite-100"><span class="training-meta-icon absolute top-1 left-0 text-brand-400"><GuideIcon kind="time" /></span>Duración</dt>
                <dd class="ml-1.5 inline">{option.duration}</dd>
              </div>
            </dl>
            <a class="mt-3 inline-block text-sm font-semibold text-brand-400 underline-offset-4 hover:underline" href={`/formacion/#${option.id}`}>Ver programa y condiciones <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>
    </>
  ) : (
    <p class="mt-4 max-w-prose text-sm leading-relaxed text-graphite-300">El directorio aún no tiene una opción específica para esta vacante. <a href="/formacion/" class="font-medium text-brand-400 underline underline-offset-4">Explora el directorio de formación</a>.</p>
  )}
</section>

<style>
  .training-meta-icon :global(svg) {
    display: block;
    width: 1rem;
    height: 1rem;
  }
</style>

<JobExperienceGuide guide={guide} step={7} experience={experience} />
