---
import JobSectionHeading from './JobSectionHeading.astro';
import JobAnalysisAdvice from './JobAnalysisAdvice.astro';
import type { jobAnalysis } from '../lib/job-analysis.mjs';
import JobExperienceGuide from './JobExperienceGuide.astro';
import GuideIcon from './guides/GuideIcon.astro';
import { applicationPreparation } from '../lib/application-preparation';
import { trainingForJob } from '../lib/job-training';
import type { careerGuidance } from '../lib/job-guidance.mjs';
import type { Job } from '../schemas';
import type { jobWorksite } from '../lib/job-worksite.mjs';

interface Props { worksite: ReturnType<typeof jobWorksite>; guide: ReturnType<typeof careerGuidance>; job: Job; title: string; tools: string[]; experience?: string; analysis: ReturnType<typeof jobAnalysis>; semantic?: Record<string, number> }
const { worksite, guide, job, title, tools, experience, analysis, semantic } = Astro.props;
const preparation = applicationPreparation(job, title, guide.skill ?? guide.experienceSkill, tools, experience, guide.questions[0], worksite);
const programs = await trainingForJob(job, worksite.region, semantic);
---
<section class="mt-10 border-t border-graphite-700 pt-7" aria-labelledby="application-guide-title" data-application-guide>
  <JobSectionHeading id="application-guide-title" step={5}>Prepara tu postulación</JobSectionHeading>
  <p class="mt-2 text-sm text-graphite-300">Usa los datos publicados como punto de partida y confirma las condiciones con el empleador.</p>
  <ol class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
    {preparation.map(step => (
      <li class="grid grid-cols-[2.75rem_minmax(0,1fr)] items-start gap-3.5 rounded-xl border border-graphite-700 bg-graphite-900 p-4 sm:block">
        <div class="flex size-11 items-center justify-center rounded-xl border border-graphite-700 bg-graphite-850 text-brand-400 [&_svg]:size-6">
          <GuideIcon kind={step.icon} />
        </div>
        <div class="pb-1 sm:mt-3">
          <h3 class="font-semibold text-graphite-100">{step.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-graphite-200">{step.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<section class="mt-10 border-t border-graphite-700 pt-7" aria-labelledby="job-training-title" data-guidance-training>
  <JobSectionHeading id="job-training-title" step={6}>¿No tienes las habilidades que te piden?</JobSectionHeading>
  {analysis?.skills.length ? <JobAnalysisAdvice items={analysis.skills} /> : null}
  {programs.length ? (
    <ul class="mt-4 grid gap-3 sm:grid-cols-2" role="list">
      {programs.map(({ slug, metadata, center, location, local, topic }) => (
        <li class="min-w-0">
          <a href={`/formacion/${slug}/`} class="group flex h-full items-start gap-3 rounded-xl border border-graphite-700 bg-graphite-850 p-4 hover:border-brand-500/50">
            <span class="shrink-0 text-brand-400 [&_svg]:size-6"><GuideIcon kind="credential" /></span>
            <div class="min-w-0">
              <h3 class="font-semibold leading-snug text-graphite-100 group-hover:text-brand-400">{metadata.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-graphite-200">{center.name} · {location}</p>
              {local && <p class="mt-1 text-xs text-brand-300">En la región de la vacante</p>}
              {topic && <p class="mt-2 text-sm text-graphite-200">Refuerza {topic}.</p>}
              {metadata.costLabel && <p class="mt-1 text-sm text-graphite-300">{metadata.costLabel}</p>}
              <span class="mt-2 inline-block text-sm font-semibold text-brand-400">Ver programa <span aria-hidden="true">→</span></span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <a href="/formacion/" class="mt-4 inline-block text-sm font-medium text-brand-400 hover:text-brand-300">Buscar opciones de formación <span aria-hidden="true">→</span></a>
  )}
</section>

<JobExperienceGuide advice={analysis?.experience} guide={guide} step={7} experience={experience} internship={job.internship} />
