---
import JobSectionHeading from './JobSectionHeading.astro';
import JobAnalysisAdvice from './JobAnalysisAdvice.astro';
import type { jobAnalysis } from '../lib/job-analysis.mjs';
import JobExperienceGuide from './JobExperienceGuide.astro';
import GuideIcon from './guides/GuideIcon.astro';
import { applicationPreparation } from '../lib/application-preparation';
import { education } from '../lib/education';
import type { careerGuidance } from '../lib/job-guidance.mjs';
import type { Job } from '../schemas';

interface Props { guide: ReturnType<typeof careerGuidance>; job: Job; title: string; tools: string[]; experience?: string; analysis: ReturnType<typeof jobAnalysis> }
const { guide, job, title, tools, experience, analysis } = Astro.props;
const training = guide.trainingIds.flatMap((id: string) => education.filter(option => option.id === id));
const preparation = applicationPreparation(job, title, guide.skill ?? guide.experienceSkill, tools, experience, guide.questions[0]);

---
<section class="mt-10 border-t border-graphite-700 pt-7" aria-labelledby="application-guide-title" data-application-guide>
  <JobSectionHeading id="application-guide-title" step={5}>Prepara tu postulación</JobSectionHeading>
  <p class="mt-2 text-sm text-graphite-300">Usa los datos publicados como punto de partida y confirma las condiciones con el empleador.</p>
  <ol class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
    {preparation.map(step => (
      <li class="grid grid-cols-[2.75rem_minmax(0,1fr)] items-start gap-3.5 rounded-xl border border-graphite-700 bg-graphite-900 p-4 sm:block">
        <div class="flex size-11 items-center justify-center rounded-xl border border-graphite-700 bg-graphite-850 text-brand-400 [&_svg]:size-6">
          <GuideIcon kind={step.icon} />
        </div>
        <div class="pb-1 sm:mt-3">
          <h3 class="font-semibold text-graphite-100">{step.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-graphite-200">{step.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<section class="mt-10 border-t border-graphite-700 pt-7" aria-labelledby="job-training-title" data-guidance-training>
  <JobSectionHeading id="job-training-title" step={6}>¿No tienes las habilidades que te piden?</JobSectionHeading>
  {analysis?.skills.length ? <JobAnalysisAdvice items={analysis.skills} /> : <p class="mt-3 flex max-w-prose items-start gap-2.5 text-sm leading-relaxed text-graphite-200">
    <span class="mt-0.5 shrink-0 text-brand-400 [&_svg]:size-5"><GuideIcon kind="credential" /></span>
    <span>Empieza por la habilidad obligatoria que te falta. Antes de inscribirte, comprueba que el programa la enseñe y compara las horas de práctica, el costo total y la credencial.</span>
  </p>}
  {training.length ? (
    <>
      {guide.skill && <p class="mt-5 text-sm text-graphite-300">Opciones relacionadas con {guide.skill}.</p>}
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {training.map(option => (
          <li class="min-w-0 rounded-xl border border-graphite-700 bg-graphite-850 p-4">
            <div class="flex items-start gap-2.5">
              <span class="text-brand-400 [&_svg]:size-6"><GuideIcon kind="credential" /></span>
              <div>
                <h3 class="font-semibold leading-snug text-graphite-100">{option.title}</h3>
                <p class="mt-0.5 text-sm text-graphite-300">{option.name} · {option.location}</p>
              </div>
            </div>
            <dl class="mt-3 space-y-2 text-sm leading-relaxed text-graphite-200">
              <div class="relative pl-6">
                <dt class="inline font-medium text-graphite-100"><span class="training-meta-icon absolute top-1 left-0 text-brand-400"><GuideIcon kind="cost" /></span>Costo</dt>
                <dd class="ml-1.5 inline">{option.costLabel}. {option.costNote}.</dd>
              </div>
              <div class="relative pl-6">
                <dt class="inline font-medium text-graphite-100"><span class="training-meta-icon absolute top-1 left-0 text-brand-400"><GuideIcon kind="time" /></span>Duración</dt>
                <dd class="ml-1.5 inline">{option.duration}</dd>
              </div>
            </dl>
            <a class="mt-3 inline-block text-sm font-semibold text-brand-400 underline-offset-4 hover:underline" href={`/formacion/?opcion=${encodeURIComponent(option.id)}#${option.id}`}>Ver programa y condiciones <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>
    </>
  ) : (
    <p class="mt-4 max-w-prose text-sm leading-relaxed text-graphite-300">El directorio aún no tiene una opción específica para esta vacante. <a href="/formacion/" class="inline-block font-medium text-brand-400 hover:text-brand-300">Explora más formaciones <span aria-hidden="true">↗</span></a></p>
  )}
</section>

<style>
  .training-meta-icon :global(svg) {
    display: block;
    width: 1rem;
    height: 1rem;
  }
</style>

<JobExperienceGuide advice={analysis?.experience} guide={guide} step={7} experience={experience} internship={job.internship} />
