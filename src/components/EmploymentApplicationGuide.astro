---
import JobSectionHeading from './JobSectionHeading.astro';
import JobExperienceGuide from './JobExperienceGuide.astro';
import GuideIcon from './guides/GuideIcon.astro';
import { education } from '../lib/education';
import type { careerGuidance } from '../lib/job-guidance.mjs';
import type { Job } from '../schemas';

interface Props { guide: ReturnType<typeof careerGuidance>; job: Job; tools: string[]; experience?: string }
const { guide, job, tools, experience } = Astro.props;
const training = guide.trainingIds.flatMap((id: string) => education.filter(option => option.id === id));
---
<section class="mt-12 border-t border-graphite-700 pt-8" aria-labelledby="application-guide-title" data-application-guide>
  <JobSectionHeading id="application-guide-title" step={2}>Prepara tu postulación</JobSectionHeading>
  <p class="mt-2 text-sm text-graphite-300">Usa los datos publicados como punto de partida y confirma las condiciones con el empleador.</p>
  <ol class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {[
      { icon: 'credential', title: 'Relaciona tu experiencia', text: experience ? `El anuncio menciona «${experience}». Prepara fechas, responsabilidades y un resultado verificable para explicar tu trayectoria.` : 'Identifica las tareas del anuncio y prepara un ejemplo concreto de tu aporte y sus resultados.' },
      { icon: 'practice', title: 'Muestra cómo trabajas', text: tools.length ? `Si tienes experiencia con ${tools.slice(0, 3).join(', ')}, prepara un ejemplo de uso y explica tu aporte sin atribuirte experiencia que no tienes.` : guide.questions[0] },
      { icon: 'time', title: 'Confirma antes de postular', text: job.city ? `Confirma el lugar exacto de trabajo en ${job.city}, el régimen y quién cubre los traslados. ${guide.questions[1]}` : `Pregunta por la sede, el régimen y quién cubre los traslados. ${guide.questions[1]}` },
    ].map((step, index) => (
      <li class="grid grid-cols-[2.75rem_1fr] gap-3.5 rounded-xl border border-graphite-700 bg-graphite-900 p-4 sm:block">
        <div class="flex size-11 items-center justify-center rounded-xl border border-graphite-700 bg-graphite-850 text-brand-400 [&_svg]:size-6">
          <GuideIcon kind={step.icon as 'credential' | 'practice' | 'time'} />
        </div>
        <div class="pb-1 sm:mt-3">
          <h3 class="font-semibold text-graphite-100">{step.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-graphite-200">{step.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<section class="mt-10 border-t border-graphite-700 pt-7" aria-labelledby="job-training-title" data-guidance-training>
  <JobSectionHeading id="job-training-title" step={3}>¿No tienes las habilidades que te piden?</JobSectionHeading>
  <p class="mt-2 max-w-prose text-sm text-graphite-300">Es normal encontrar requisitos que aún no dominas: las herramientas cambian y la formación de cada persona sigue un recorrido distinto. Antes de inscribirte:</p>
  <ul class="mt-2 max-w-prose list-disc space-y-1 pl-5 text-sm text-graphite-300 marker:text-brand-400"><li>Separa lo obligatorio de lo deseable en el anuncio.</li><li>Comprueba si ya puedes acreditar la habilidad con experiencia o proyectos; compara temario, costo total y credencial.</li></ul>
  {training.length ? (
    <>
      <p class="mt-2 max-w-prose text-sm leading-relaxed text-graphite-300">{guide.skill ? `Compara opciones relacionadas con ${guide.skill} o cerca de la vacante. Revisa el temario y la credencial frente a lo que pide el puesto.` : 'Compara opciones de formación cerca de la vacante. Revisa el temario y la credencial frente a lo que pide el puesto.'}</p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {training.map(option => (
          <li class="min-w-0 rounded-xl border border-graphite-700 bg-graphite-850 p-4">
            <div class="flex items-start gap-2.5">
              <span class="text-brand-400 [&_svg]:size-6"><GuideIcon kind="credential" /></span>
              <div>
                <h3 class="font-semibold leading-snug text-graphite-100">{option.title}</h3>
                <p class="mt-0.5 text-sm text-graphite-300">{option.name} · {option.location}</p>
              </div>
            </div>
            <dl class="mt-3 space-y-2 text-sm leading-relaxed text-graphite-200">
              <div class="relative pl-6">
                <dt class="inline font-medium text-graphite-100"><span class="training-meta-icon absolute top-1 left-0 text-brand-400"><GuideIcon kind="cost" /></span>Costo</dt>
                <dd class="ml-1.5 inline">{option.costLabel}. {option.costNote}.</dd>
              </div>
              <div class="relative pl-6">
                <dt class="inline font-medium text-graphite-100"><span class="training-meta-icon absolute top-1 left-0 text-brand-400"><GuideIcon kind="time" /></span>Duración</dt>
                <dd class="ml-1.5 inline">{option.duration}</dd>
              </div>
            </dl>
            <a class="mt-3 inline-block text-sm font-semibold text-brand-400 underline-offset-4 hover:underline" href={`/formacion/#${option.id}`}>Ver programa y condiciones <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>
    </>
  ) : (
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-graphite-300">El directorio aún no tiene una opción específica para esta vacante. <a href="/formacion/" class="font-medium text-brand-400 underline underline-offset-4">Explora el directorio de formación</a>.</p>
  )}
</section>

<style>
  .training-meta-icon :global(svg) {
    display: block;
    width: 1rem;
    height: 1rem;
  }
</style>

<JobExperienceGuide guide={guide} step={4} experience={experience} />
