---
interface Props {
  href: string;
  primary?: boolean;
}
const { href, primary = false } = Astro.props;
---
<a
  href={href}
  target="_blank"
  rel="noopener nofollow"
  class:list={[
    'inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition-colors',
    primary ? 'bg-brand-500 text-graphite-950 hover:bg-brand-400' : 'border border-graphite-600 text-graphite-100 hover:border-brand-500',
  ]}
>
  Postular
  <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M7 17 17 7M7 7h10v10" />
  </svg>
</a>
