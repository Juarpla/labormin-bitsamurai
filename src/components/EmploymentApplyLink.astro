---
interface Props {
  href: string;
  primary?: boolean;
}
const { href, primary = false } = Astro.props;
---
<a
  href={href}
  target="_blank"
  rel="noopener nofollow"
  class:list={[
    'inline-flex items-center rounded-full px-6 py-3 text-sm font-semibold transition-colors',
    primary ? 'bg-brand-500 text-graphite-950 hover:bg-brand-400' : 'border border-graphite-600 text-graphite-100 hover:border-brand-500',
  ]}
>
  Postular
</a>
