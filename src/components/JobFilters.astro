---
import { useTranslations, countryName, GLOBAL, type Locale } from '../lib/i18n';
import { categoryOrder, categoryLabel } from '../lib/jobs';
import type { JobMeta } from '../lib/catalog-data';

interface Props { jobs: Pick<JobMeta, 'country' | 'category'>[]; locale: Locale }
const { jobs, locale } = Astro.props;
const t = useTranslations(locale);
const params = Astro.url.searchParams;
const action = Astro.url.pathname;
const tier = params.get('tier');
const presentCountries = [...new Set(jobs.map(job => job.country))];
const presentCategories = [...new Set(jobs.map(job => job.category))].sort(
  (a, b) => categoryOrder.indexOf(a) - categoryOrder.indexOf(b)
);
---

  <form action={`${action}#resultados`} method="get" role="search" aria-label="Filtrar vacantes" class="mt-10 rounded-2xl border border-graphite-800 bg-graphite-900/60 p-4">
    {(tier === "pe" || tier === "remote") && <input type="hidden" name="tier" value={tier} />}
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex min-w-0 flex-col gap-1">
        <label for="f-country" class="text-xs font-semibold uppercase tracking-widest text-graphite-400">{t('jobs.filter.country')}</label>
        <select id="f-country" name="country" class="w-full rounded-xl border border-graphite-700 bg-graphite-900 px-3 py-2 text-sm outline-none focus:border-brand-500">
          <option value="">{t('jobs.filter.all')}</option>
          {presentCountries.map((c) => <option value={c} selected={params.get('country') === c}>{c === GLOBAL ? t('card.global') : countryName(c)}</option>)}
        </select>
      </div>
      <div class="flex min-w-0 flex-col gap-1">
        <label for="f-category" class="text-xs font-semibold uppercase tracking-widest text-graphite-400">{t('jobs.filter.category')}</label>
        <select id="f-category" name="category" class="w-full rounded-xl border border-graphite-700 bg-graphite-900 px-3 py-2 text-sm outline-none focus:border-brand-500">
          <option value="">{t('jobs.filter.all')}</option>
          {presentCategories.map((c) => <option value={c} selected={params.get('category') === c}>{categoryLabel(c)}</option>)}
        </select>
      </div>
      <div class="flex min-w-0 flex-col gap-1">
        <label for="f-type" class="text-xs font-semibold uppercase tracking-widest text-graphite-400">{t('jobs.filter.type')}</label>
        <select id="f-type" name="type" class="w-full rounded-xl border border-graphite-700 bg-graphite-900 px-3 py-2 text-sm outline-none focus:border-brand-500">
          <option value="">{t('jobs.filter.all')}</option>
          <option value="onsite" selected={params.get('type') === 'onsite'}>{t('jobs.type.onsite')}</option>
          <option value="remote" selected={params.get('type') === 'remote'}>{t('jobs.type.remote')}</option>
        </select>
      </div>
      <div class="flex min-w-0 flex-col gap-1">
        <label for="f-search" class="text-xs font-semibold uppercase tracking-widest text-graphite-400">{t('jobs.filter.searchLabel')}</label>
        <input
          id="f-search" name="q" value={(params.get('q') ?? '').slice(0, 120)} maxlength="120"
          type="search"
          placeholder={t('jobs.filter.search')}
          class="w-full rounded-xl border border-graphite-700 bg-graphite-900 px-3 py-2 text-sm outline-none focus:border-brand-500"
        />
      </div>
    </div>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-x-2 gap-y-2">
      <button type="submit" class="min-h-11 rounded-full bg-brand-500 px-4 text-sm font-semibold text-graphite-950 hover:bg-brand-400">Aplicar filtros</button>
      <a
        id="f-clear"
        href={`${action}#resultados`}
        class="rounded-full border border-graphite-700 px-3.5 py-1.5 text-sm text-graphite-200 outline-none transition-colors hover:border-brand-500 hover:text-brand-400 focus-visible:border-brand-500"
      >
        {t('jobs.clear')}
      </a>
    </div>
  </form>
