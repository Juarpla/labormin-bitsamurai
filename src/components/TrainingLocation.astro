---
import TrainingIllustration from './TrainingIllustration.astro';
import type { TrainingProgram } from '../lib/catalog-data';

type Place = NonNullable<TrainingProgram['location']>;
interface Props { place?: Place; online?: boolean; notes?: TrainingProgram['notes']; }
const { place, online, notes = [] } = Astro.props;
const campus = place?.kind === 'campus' ? place : undefined;
const query = campus?.address ?? (place ? `${place.label.replaceAll(' · ', ', ')}, Perú` : '');
const maps = query && `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
const area = notes.filter(note => note.kind === 'area');
---
<section class="training-section" id="ubicacion" aria-labelledby="training-location-title" data-training-location={online ? 'virtual' : place?.kind ?? 'unknown'}>
  <h2 id="training-location-title">{online ? 'Cómo se dicta' : 'Ubicación y acceso'}</h2>
  <div class="training-location">
    <div class="training-location-graphic"><TrainingIllustration kind={online ? 'virtual' : campus ? 'campus' : 'location'} /></div>
    <div class="training-location-copy">
      <h3>{online ? 'Aula virtual · desde Perú' : place?.label ?? 'Perú'}</h3>
      {online ? null : (
        campus ? <address>{campus.address}</address> : <p>{place ? 'Ubicación de referencia. Confirma la sede y el horario con el centro.' : 'Consulta en la fuente dónde se imparte esta formación.'}</p>
      )}
      {area.map(note => <p>{note.text} <a class="training-text-link" href={note.url}>{note.label}</a></p>)}
      <div class="training-location-links">
        {maps && <a class="training-text-link" href={maps} target="_blank" rel="noopener noreferrer">{campus ? 'Abrir en Google Maps' : 'Ver la zona en Google Maps'} <span aria-hidden="true">↗</span><span class="sr-only"> (nueva pestaña)</span></a>}
        {place?.source && !area.some(note => note.url === place.source?.url) && <a class="training-text-link" href={place.source.url}>{place.source.label}</a>}
      </div>
    </div>
    {campus?.embed && <details class="training-map" data-training-map>
      <summary><span class="training-map-closed">Ver mapa</span><span class="training-map-open">Ocultar mapa</span> <svg viewBox="0 0 16 16" aria-hidden="true" fill="none"><path d="m4 6 4 4 4-4"/></svg></summary>
      <p class="training-map-status" data-training-map-status role="status" hidden></p>
      <iframe title={`Mapa de la sede en ${campus.label}`} data-training-map-src={campus.embed} hidden referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      <a class="training-text-link training-map-fallback" href={maps} target="_blank" rel="noopener noreferrer">Abrir el mapa en otra pestaña <span aria-hidden="true">↗</span></a>
      <noscript><p>Abre el enlace de Google Maps para ver la sede.</p></noscript>
    </details>}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-training-map]').forEach(disclosure => {
    const frame = disclosure.querySelector<HTMLIFrameElement>('[data-training-map-src]');
    const status = disclosure.querySelector<HTMLElement>('[data-training-map-status]');
    disclosure.addEventListener('toggle', () => {
      if (disclosure.open && frame?.dataset.trainingMapSrc && !frame.hasAttribute('src')) {
        if (status) {
          status.hidden = false;
          status.textContent = 'Cargando el mapa de Google…';
          const wait = window.setTimeout(() => { status.textContent = 'El mapa está tardando en cargar.'; }, 10000);
          frame.addEventListener('load', () => {
            window.clearTimeout(wait);
            status.hidden = true;
          }, { once: true });
        }
        frame.hidden = false;
        frame.src = frame.dataset.trainingMapSrc;
      }
    });
  });
</script>
