---
import type { Job } from '../schemas';
import { allJobs } from '../lib/jobs';
import { education, trainingGuidePath, verifiedDate } from '../lib/education';
import { applicationGuidance, experienceOpportunity } from '../lib/job-guidance.mjs';
import cachedGuidance from '../data/job-guidance.json';

interface Props { job: Job }
const { job } = Astro.props;
const technical = /electric|mec[aá]nic|manten|soldad|t[eé]cnic|instrument/i.test(job.title);
const operations = /operador|operari|conductor|chofer|volquete/i.test(job.title);
const earlyCareer = job.internship || /pr[aá]ctic|trainee|becari|sin experiencia/i.test(job.title);
const preparation = earlyCareer
  ? 'Si la convocatoria es de prácticas, distingue si pide estudiante o egresado y revisa qué constancia debe emitir tu centro de estudios. No asumas que ambos perfiles son intercambiables.'
  : technical
    ? 'Para un puesto técnico, identifica los equipos, especialidades y certificados que el anuncio nombre. Prepara ejemplos de trabajos que hayas realizado con ellos; un curso general no sustituye la experiencia específica que se pida.'
    : operations
      ? 'Para un puesto de operación o conducción, compara el equipo mencionado, la categoría de licencia y la experiencia solicitada con tus documentos vigentes. La experiencia en una máquina no acredita automáticamente otra.'
      : 'Separa los requisitos obligatorios de los deseables. Junto a cada obligatorio, anota una evidencia real: estudio, certificado, proyecto o experiencia. Si el anuncio no distingue prioridades, consulta antes de descartar tu candidatura.';
const guide = applicationGuidance(job, Object.hasOwn(cachedGuidance, job.id) ? cachedGuidance[job.id as keyof typeof cachedGuidance] : undefined);
const training = education.find(option => option.id === guide.educationId);
const opportunity = experienceOpportunity(job, allJobs);
---

<section class="mt-12 border-t border-graphite-700 pt-8" aria-labelledby="application-guide-title" data-application-guide>
  <h2 id="application-guide-title" class="font-display text-2xl font-semibold text-graphite-100">Prepara tu postulación</h2>
  <p class="mt-3 max-w-prose text-sm leading-relaxed text-graphite-400">Orientación de Labormin para evaluar esta oportunidad. Estas recomendaciones son independientes de los requisitos y beneficios que declara el empleador.</p>

  <h3 class="mt-6 text-base font-semibold text-graphite-100">Qué verificar antes de postular</h3>
  <p class="mt-2 max-w-prose leading-relaxed text-graphite-200">{preparation}</p>
  {job.descriptionStatus !== 'full' && <p class="mt-3 max-w-prose text-sm leading-relaxed text-graphite-200">Consulta el anuncio original para confirmar los requisitos y las condiciones que faltan en esta ficha.</p>}
  <ul class="mt-3 ml-5 max-w-prose list-disc space-y-2 text-sm leading-relaxed text-graphite-200">
    {guide.questions.map(question => <li>{question}</li>)}
  </ul>
  {guide.selectedByAi && <p class="mt-2 text-xs text-graphite-400" data-ai-guidance>Preguntas de Labormin seleccionadas con ayuda de IA.</p>}

  {training && <div class="mt-6" data-guidance-training>
    <h3 class="text-base font-semibold text-graphite-100">Cómo cerrar una brecha de formación</h3>
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-graphite-200">Si necesitas reforzar tu base en {guide.skill}, revisa <a class="text-brand-400 underline underline-offset-4" href={trainingGuidePath + '#' + training.id}>{training.title} · {training.name}</a>. Confirma los cupos, costos y requisitos con la institución. La formación complementa la experiencia que pida el empleador.</p>
    <p class="mt-2 text-xs text-graphite-400">{training.location} · Fuente consultada el <time datetime={training.lastVerifiedAt}>{verifiedDate(training.lastVerifiedAt)}</time>.</p>
  </div>}

  {opportunity && <div class="mt-6" data-guidance-experience>
    <h3 class="text-base font-semibold text-graphite-100">Una vacante para ganar experiencia</h3>
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-graphite-200"><a class="text-brand-400 underline underline-offset-4" href={'/jobs/' + opportunity.slug + '/'}>{opportunity.title}</a> · {opportunity.company}{opportunity.city && ' · ' + opportunity.city}. Comparte el área de {guide.skill}. Consulta las tareas y los requisitos antes de postular.</p>
  </div>}
</section>
