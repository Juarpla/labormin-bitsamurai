---
import type { Job } from '../schemas';
import { countryName, DEFAULT_COUNTRY } from '../lib/i18n';
import type { jobAnalysis } from '../lib/job-analysis.mjs';
import { employerContext } from '../lib/employer-context';
import JobLocationMap from './JobLocationMap.astro';
import GuideIcon from './guides/GuideIcon.astro';
import JobRoleJourney from './JobRoleJourney.astro';
import JobSectionHeading from './JobSectionHeading.astro';

interface Props { job: Job; skill: string | null; title: string; experience?: string; analysis: ReturnType<typeof jobAnalysis> }
const { job, skill, title, experience, analysis } = Astro.props;
const city = job.city?.trim();
const country = countryName(job.country);
const remoteBase = countryName(DEFAULT_COUNTRY);
const place = city ? `${city}, ${country}` : country;
const maps = (query: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
const search = (query: string) => `https://www.google.com/search?q=${encodeURIComponent(query)}`;
const employer = employerContext(job.company, job.country, job.internship);
const profile = employer?.profile;
const locations = employer?.locations ?? [];
const reviews = employer?.reviewSummary?.highlights ?? employer?.reviewHighlights ?? [];
const companySearch = search(job.internship ? `${job.company} experiencias de practicantes` : `${job.company} opiniones laborales ${title}`);
const locationChecks: { icon: 'time' | 'credential' | 'travel' | 'cost'; title: string; text: string; link?: { href: string; label: string } }[] = job.remote ? [
  { icon: 'time', title: 'Horario y coordinación', text: 'Confirma cuántas horas debes coincidir con el equipo, por qué canales coordinan y si hay reuniones o viajes presenciales.' },
  { icon: 'credential', title: 'Contrato y equipo', text: 'Pregunta qué entidad te contrataría desde Perú y quién cubre el equipo, las licencias y la conexión.' },
] : [
  {
    icon: 'travel', title: 'Traslado y régimen',
    text: job.internship
      ? 'Confirma si la práctica es en oficina o en operación. Pregunta desde dónde sale el transporte si hay visitas a mina.'
      : 'Pregunta dónde empieza el traslado, cuánto toma y si los turnos implican quedarte en campamento. Revisa el clima y la altitud de la operación.',
    link: city ? { href: search(`clima altitud ${place}`), label: 'Consultar clima y altitud' } : undefined,
  },
  {
    icon: 'cost', title: 'Gastos y alojamiento',
    text: 'Con la sede confirmada, compara alojamiento, comidas y transporte. Pregunta qué gastos cubre la empresa.',
    link: city ? { href: maps(`alojamiento en ${place}`), label: 'Buscar alojamiento en el mapa' } : undefined,
  },
];
---
<section class="mt-10 border-t border-graphite-700 pt-7" aria-labelledby="role-context-title">
  <JobSectionHeading id="role-context-title" step={2}>{job.internship ? 'Conoce la práctica' : 'Conoce el puesto'}</JobSectionHeading>
  <p class="mt-3 max-w-prose text-sm leading-relaxed text-graphite-200">
    Para <strong class="text-graphite-100">{title}</strong>, {job.internship
      ? 'revisa qué tareas podrías aprender y pregunta quién supervisaría tu trabajo'
      : skill
        ? `toma ${skill} como punto de partida para comparar funciones y herramientas`
        : 'compara el alcance de las tareas con otros anuncios de la misma especialidad'}.
    {experience && <> El anuncio menciona <strong class="text-graphite-100">{experience}</strong>.</>}
  </p>
  <JobRoleJourney skill={skill} internship={job.internship} />
  <a href={job.internship ? '/practicas/' : search(`${title} funciones empleo minería ${job.remote ? remoteBase : country}`)} target={job.internship ? undefined : '_blank'} rel={job.internship ? undefined : 'noopener noreferrer'} class="mt-3 inline-block text-sm font-semibold text-brand-400 underline-offset-4 hover:underline">{job.internship ? 'Ver prácticas vigentes' : 'Buscar puestos similares'} <span aria-hidden="true">{job.internship ? '→' : '↗'}</span></a>
</section>

<section class="mt-10 border-t border-graphite-700 pt-7" aria-labelledby="place-context-title">
  <JobSectionHeading id="place-context-title" step={3}>{job.remote ? 'Cómo sería trabajar en remoto' : 'Antes de trasladarte'}</JobSectionHeading>
  <div class="mt-4 overflow-hidden rounded-xl border border-graphite-700">
    <div class="grid grid-cols-[2.5rem_minmax(0,1fr)] items-start gap-3 bg-graphite-850 p-4 sm:p-5">
      <span class="grid size-10 place-items-center rounded-lg border border-graphite-700 bg-graphite-900 text-brand-400 [&_svg]:size-6"><GuideIcon kind={job.remote ? 'remote' : 'map'} /></span>
      <div>
        <h3 class="font-semibold text-graphite-100">{job.remote ? `Trabajo remoto desde ${remoteBase}` : place}</h3>
        <p class="mt-1 max-w-prose text-sm leading-relaxed text-graphite-200">{job.remote
          ? 'Si vas a trabajar desde casa, revisa tu conexión, un respaldo de internet y un espacio para llamadas. Si necesitas un espacio alternativo, comprueba sus horarios y conectividad.'
          : city
            ? 'Usa la ciudad publicada como referencia. Pide la dirección de la sede y el punto de encuentro antes de trazar la ruta.'
            : locations.length
              ? `El anuncio ubica la vacante en ${country}. Confirma la unidad antes de organizar el viaje. Las ubicaciones de la empresa se detallan en la siguiente sección.`
              : `La vacante indica ${country}. Pide el departamento y la sede para calcular el viaje.`}</p>
        <a href={maps(job.remote ? `coworking en ${remoteBase}` : place)} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm font-semibold text-brand-400 underline-offset-4 hover:underline">
          {job.remote ? 'Buscar espacios de coworking en Google Maps' : `Ver ${city || country} en Google Maps`} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    {!job.remote && locations.length > 0 && (
      <div class="border-t border-graphite-700 bg-graphite-900 px-4 py-3 sm:px-5">
        <p class="max-w-prose text-sm leading-relaxed text-graphite-200">
          {employer?.travel}
        </p>
        <a href="#company-locations" class="mt-1 inline-block text-sm font-medium text-brand-400 underline-offset-4 hover:underline">Ver sedes y accesos</a>
      </div>
    )}
    <ul role="list" class="grid divide-y divide-graphite-700 border-t border-graphite-700 bg-graphite-900 sm:grid-cols-2 sm:divide-x sm:divide-y-0">
      {locationChecks.map(({ icon, title, text, link }) => (
        <li class="flex items-start gap-3 p-4 sm:p-5">
          <span class="shrink-0 text-brand-400 [&_svg]:size-5"><GuideIcon kind={icon} /></span>
          <div>
            <h3 class="text-sm font-semibold text-graphite-100">{title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-graphite-200">{text}</p>
            {link && <a href={link.href} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm font-semibold text-brand-400 underline-offset-4 hover:underline">{link.label} <span aria-hidden="true">↗</span></a>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="mt-10 border-t border-graphite-700 pt-7" aria-labelledby="company-context-title">
  <JobSectionHeading id="company-context-title" step={4}>Investiga a {job.company}</JobSectionHeading>
  {(profile || analysis?.company) && (
    <div class="mt-4 max-w-prose space-y-2 text-sm leading-relaxed text-graphite-200">
      {profile && <p>{profile.summary} <a href={profile.summaryUrl ?? employer?.officialUrl} target="_blank" rel="noopener noreferrer" class="text-brand-400 underline-offset-4 hover:underline">Perfil oficial <span aria-hidden="true">↗</span></a></p>}
      {analysis?.company && <p><strong class="text-graphite-100">Qué investigar.</strong> {analysis.company}</p>}
    </div>
  )}
  <h3 id="company-locations" class="mt-4 scroll-mt-28 font-semibold text-graphite-100">Sedes y operaciones</h3>
  {locations.length ? (
    <>
      <p class="mt-1 max-w-prose text-sm leading-relaxed text-graphite-300">
        {profile?.network ?? 'Ubicaciones publicadas por la empresa.'} Confirma con selección la dirección asignada a esta {job.internship ? 'práctica' : 'vacante'}.
        <a href={employer?.officialUrl} target="_blank" rel="noopener noreferrer" class="ml-1 inline-block text-brand-400 underline-offset-4 hover:underline">Fuente oficial <span aria-hidden="true">↗</span></a>
      </p>
      <ul role="list" class="mt-3 grid gap-3 sm:grid-cols-2">
        {locations.map(location => (
          <li class:list={["min-w-0 rounded-xl border border-graphite-700 bg-graphite-900 p-4", location.headquarters && "sm:col-span-2"]}>
            <h4 class="flex items-start gap-2 font-semibold text-graphite-100">
              <span class="mt-0.5 shrink-0 text-brand-400 [&_svg]:size-5"><GuideIcon kind="map" /></span>
              {location.name}
            </h4>
            <p class="mt-1 text-sm font-medium text-graphite-300">{location.address}</p>
            <p class="mt-2 text-sm leading-relaxed text-graphite-200">{location.description}</p>
            {location.sourceUrl && <a href={location.sourceUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm text-brand-400 underline-offset-4 hover:underline">Fuente de esta ubicación <span aria-hidden="true">↗</span></a>}
            <JobLocationMap query={location.headquarters ? `${location.address}, ${country}` : `${location.name}, ${job.company}, ${location.address}, ${country}`} label={location.name} />
          </li>
        ))}
      </ul>
    </>
  ) : (
    <div class="mt-2 rounded-xl border border-graphite-700 bg-graphite-900 p-4">
      <p class="max-w-prose text-sm leading-relaxed text-graphite-200">Busca las ubicaciones de {job.company} y confirma con selección cuál corresponde a la oferta.</p>
      <JobLocationMap query={`${job.company}, ${job.remote ? remoteBase : place}`} label={job.company} />
    </div>
  )}

  {(profile?.contactUrl || analysis?.visit) && (
    <div class="mt-5 max-w-prose space-y-2 text-sm leading-relaxed text-graphite-200">
      <h3 class="font-semibold text-graphite-100">Contacto y llegada</h3>
      {profile?.contactTip && <p>{profile.contactTip}</p>}
      {analysis?.visit && <p>{analysis.visit}</p>}
      <div class="flex flex-wrap gap-x-5 gap-y-1">
        {profile?.contactUrl && <a href={profile.contactUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-400 underline-offset-4 hover:underline">Contacto oficial <span aria-hidden="true">↗</span></a>}
        {profile?.phone && <a href={`tel:${profile.phone}`} class="font-semibold text-brand-400 underline-offset-4 hover:underline">Central {profile.phoneLabel}</a>}
      </div>
    </div>
  )}

  <h3 class="mt-6 font-semibold text-graphite-100">{employer?.practiceSample ? 'Experiencias de practicantes' : 'Opiniones sobre trabajar en la empresa'}</h3>
  {reviews.length > 0 && (
    <>
      <p class="mt-1 text-sm text-graphite-300">{employer?.reviewSummary
        ? `Temas mencionados en una muestra de ${employer.reviewSummary.total} opiniones públicas en Indeed.`
        : 'Resumen de testimonios públicos en Indeed sobre distintos equipos y sedes.'}</p>
      <dl class="mt-2 max-w-prose divide-y divide-graphite-700 text-sm leading-relaxed">
        {reviews.map(review => (
          <div class="py-2.5">
            <dt class="font-medium text-graphite-100">{review.topic}</dt>
            <dd class="mt-0.5 text-graphite-200">{review.text}</dd>
          </div>
        ))}
      </dl>
    </>
  )}
  <div class="mt-2 pl-4">
    <a href={employer?.reviewsUrl ?? companySearch} target="_blank" rel="noopener noreferrer" class="inline-block text-sm font-semibold text-brand-400 underline-offset-4 hover:underline">{employer?.reviewsUrl ? 'Ver opiniones en Indeed' : job.internship ? 'Buscar testimonios de practicantes' : 'Buscar opiniones laborales'} <span aria-hidden="true">↗</span></a>
  </div>
</section>
