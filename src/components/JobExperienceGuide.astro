---
import JobAnalysisAdvice from './JobAnalysisAdvice.astro';
import JobSectionHeading from './JobSectionHeading.astro';
import GuideIcon from './guides/GuideIcon.astro';
import type { careerGuidance } from '../lib/job-guidance.mjs';

interface Props {
  advice?: { evidence: string; advice: string }[];
  guide: ReturnType<typeof careerGuidance>;
  step?: number;
  experience?: string;
  internship?: boolean;
}
const { advice, guide, step, experience, internship } = Astro.props;
---
<section class="mt-10 border-t border-graphite-700 pt-7" aria-labelledby="job-experience-title"  data-guidance-experience>
  <JobSectionHeading id="job-experience-title" step={step}>{internship ? '¿Cómo puedes ganar experiencia?' : '¿Te hace falta ganar más experiencia?'}</JobSectionHeading>
  <div class="mt-3 max-w-prose space-y-2 text-sm leading-relaxed text-graphite-200">
    {experience && <p>El anuncio menciona <strong class="text-graphite-100">{experience}</strong>. Pregunta si el requisito es obligatorio y qué funciones cuentan.</p>}
    {!advice?.length && <p>{internship
      ? 'Si ya hiciste un informe, un plano o un análisis durante tus estudios, prepara una muestra y explica tu aporte. Pregunta si aceptan ese trabajo o el voluntariado como experiencia.'
      : 'Haz una lista de las tareas del anuncio que ya realizaste en proyectos o prácticas. Pregunta qué documentos acepta el empleador para acreditarlas.'}</p>}
  </div>
  {advice && advice.length > 0 && <JobAnalysisAdvice items={advice} />}
  {guide.opportunities.length ? (
    <>
      <h3 class="mt-5 text-sm font-semibold text-graphite-100">Oportunidades de nivel inicial{guide.experienceSkill && ` en ${guide.experienceSkill}`}</h3>
      <ul class="mt-4 divide-y divide-graphite-700 border-y border-graphite-700">
        {guide.opportunities.map(({ job, experience }) => (
          <li class="grid grid-cols-[1.75rem_minmax(0,1fr)] gap-x-3 gap-y-1.5 py-3.5 sm:grid-cols-[1.75rem_minmax(0,1fr)_auto]">
            <span class="mt-0.5 text-brand-400 [&_svg]:size-6"><GuideIcon kind="practice" /></span>
            <div>
              <a href={'/jobs/' + job.slug + '/'} class="font-semibold text-graphite-100 underline-offset-4 hover:text-brand-400 hover:underline">{job.title} <span class="text-brand-400" aria-hidden="true">↗</span></a>
              <p class="mt-0.5 text-sm text-graphite-300">{job.company}{job.city && ' · ' + job.city}</p>
            </div>
            <p class="col-start-2 w-fit max-w-52 self-start rounded-lg border border-graphite-700 bg-graphite-850 px-2.5 py-1 text-xs font-medium text-graphite-200 sm:col-start-auto">{experience?.text ?? 'Experiencia por confirmar'}</p>
          </li>
        ))}
      </ul>
    </>
  ) : (
    <p class="mt-4 max-w-prose text-sm leading-relaxed text-graphite-300">Por ahora no hay oportunidades afines de nivel inicial en el catálogo. <a href="/practicas/" class="inline-block font-medium text-brand-400 hover:text-brand-300">Explora más prácticas <span aria-hidden="true">↗</span></a></p>
  )}
</section>
