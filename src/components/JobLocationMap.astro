---
interface Props { query: string; label: string }
const { query, label } = Astro.props;
const encoded = encodeURIComponent(query);
const maps = `https://www.google.com/maps/search/?api=1&query=${encoded}`;
const embed = `https://maps.google.com/maps?q=${encoded}&hl=es&output=embed`;
---

<details class="mt-2.5">
  <summary class="w-fit cursor-pointer text-sm font-semibold text-brand-400 underline-offset-4 hover:underline">Ver mapa de {label}</summary>
  <iframe class="mt-3 h-56 w-full rounded-lg border border-graphite-700" title={`Mapa de ${label}`} data-map-src={embed} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
  <a href={maps} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm text-brand-400 underline-offset-4 hover:underline">Abrir en Google Maps <span aria-hidden="true">↗</span></a>
</details>

<script>
  document.querySelectorAll<HTMLIFrameElement>('iframe[data-map-src]').forEach(frame => {
    frame.parentElement?.addEventListener('toggle', () => {
      if (frame.closest('details')?.open && !frame.hasAttribute('src') && frame.dataset.mapSrc) {
        frame.src = frame.dataset.mapSrc;
      }
    });
  });
</script>
