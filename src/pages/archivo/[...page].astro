---
import JobUnavailableView from '../../components/pages/JobUnavailableView.astro';
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const previousPage = Boolean(Astro.params.page);
if (previousPage) Astro.response.status = 404;
---

<Layout title="Convocatorias anteriores | Labormin" path="/archivo/" description="Explora empleos y prácticas vigentes en Labormin." noindex ads={false}>
  <JobUnavailableView heading="Convocatorias anteriores" />
</Layout>
