---
export const prerender = false;
import CatalogPagination from '../components/CatalogPagination.astro';
import GuideIcon from '../components/guides/GuideIcon.astro';
import { paginate, resultRange, searchText } from '../lib/pagination';
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import { departments, trainingGroups, trainingGuidePath } from '../lib/education';
import '../styles/formation.css';
import { catalogRecord, openCatalog, openTrainingPrograms } from '../lib/catalog';
import { trainingDirectory } from '../lib/training';
import { trainingPath } from '../lib/training-program.mjs';
const images = { habilidad: '/images/formacion/habilidad.png', certificado: '/images/formacion/certificado.png', carrera: '/images/formacion/carrera.png' };
const params = Astro.url.searchParams;
const type = params.get('tipo') ?? '';
const department = params.get('departamento') ?? '';
const mode = params.get('modalidad') ?? '';
const cost = params.get('costo') ?? '';
const query = (params.get('q') ?? '').slice(0, 120);
const includeVirtual = !params.getAll('virtual').includes('0') || params.getAll('virtual').includes('1');
const optionId = params.get('opcion');
if (optionId && /^[a-z0-9-]{1,120}$/.test(optionId) && await catalogRecord('training', optionId)) {
  return Astro.redirect(trainingPath(optionId), 301);
}
const [centers, programs] = await Promise.all([openCatalog('training'), openTrainingPrograms()]);
const directory = trainingDirectory(centers.entries, programs.entries);
const words = searchText(query).split(/\s+/).filter(Boolean);
const filtered = directory.filter(option =>
  (!type || option.type === type) &&
  (includeVirtual || option.mode !== 'virtual') &&
  (!department || option.department === department || (includeVirtual && option.mode === 'virtual')) &&
  (!mode || option.mode === mode) && (!cost || option.costKind === cost) &&
  words.every(word => option.search.includes(word))
);
const page = paginate(filtered, Astro.url);
const icons = { habilidad: 'materials', certificado: 'credential', carrera: 'map' } as const;
function typeLink(value: string) {
  const next = new URLSearchParams(params);
  next.delete('pagina');
  next.delete('opcion');
  if (value) next.set('tipo', value);
  else next.delete('tipo');
  return `/formacion/${next.size ? '?' + next : ''}#resultados`;
}

---
<Layout title="Formación para el sector minero en Perú | Labormin" description="Explora cursos, formación práctica y carreras técnicas. Filtra por departamento, modalidad y costo; compara fuentes oficiales y credenciales." path="/formacion">
  <div class="xl:grid xl:grid-cols-[160px_56rem_160px] xl:justify-center xl:gap-4">
    <AdSlot slotId="formacion-side-1" size={{ w: 160, h: 600 }} media="(min-width: 1280px)" class="sticky top-24 hidden w-fit self-start xl:col-start-1 xl:row-start-1 xl:block" />
    <section class="formation min-w-0 xl:col-start-2 xl:row-start-1" aria-labelledby="formation-title">
    <header class="formation-hero">
      <h1 id="formation-title">¿Qué quieres <em>aprender?</em></h1>
      <p>Empieza por el tipo de formación. Después, encuentra opciones cerca de ti.</p>
    </header>
    <nav class="formation-goals" aria-label="Tipo de formación">
      {trainingGroups.map(group => <a class="formation-goal" aria-current={type === group.id ? "true" : undefined} href={typeLink(group.id)}>
        <img src={images[group.image]} alt="" width="180" height="104" fetchpriority="high"/>
        <span><strong>{group.label}</strong><span>{group.description}</span></span>
      </a>)}
    </nav>
    <a class="formation-all" href={typeLink('')}>Ver toda la formación <span aria-hidden="true">→</span></a>
    <AdSlot slotId="formacion-top-1" size={{ w: 320, h: 50 }} media="(max-width: 1023.98px)" class="mx-auto w-fit lg:hidden" />
    <form id="formation-filters" class="formation-filters" role="search" aria-label="Filtrar formación" method="get" action="/formacion/#resultados">
      {type && <input type="hidden" name="tipo" value={type} />}
      <div class="formation-search-tools">
        <label class="formation-query" for="training-query">Buscar por programa o institución<input type="search" name="q" id="training-query" placeholder="Ej. electricidad, minería, CETPRO" autocomplete="off" value={query} maxlength="120"/></label>

      </div>
      <details class="formation-filter-details" id="training-filter-details" open>
        <summary>Departamento, modalidad y costo</summary>
        <div class="formation-selects">
          <label>Departamento<select name="departamento" id="training-department"><option value="">Todos</option>{departments.map(department => <option value={department} selected={params.get('departamento') === department}>{department}</option>)}</select></label>
          <label>Modalidad<select name="modalidad" id="training-mode"><option value="">Todas</option><option value="virtual" selected={mode === "virtual"}>Virtual</option><option value="presencial" selected={mode === "presencial"}>Presencial confirmada</option><option value="consultar" selected={mode === "consultar"}>Por confirmar</option></select></label>
          <label>Costo<select name="costo" id="training-cost"><option value="">Todos</option><option value="gratuito" selected={cost === "gratuito"}>Gratuito · según condiciones</option><option value="parcial" selected={cost === "parcial"}>Pagos parciales publicados</option><option value="consultar" selected={cost === "consultar"}>Precio por consultar</option></select></label>
        </div>
        <input type="hidden" name="virtual" value="0" />
        <label class="formation-remote"><input type="checkbox" name="virtual" id="training-remote" value="1" checked={includeVirtual}/> Incluir opciones virtuales desde Perú</label>
      </details>
      <div class="formation-filter-actions">
        <button type="submit" class="min-h-11 rounded-full bg-brand-500 px-4 text-sm font-semibold text-graphite-950 hover:bg-brand-400">Aplicar filtros</button>
        <a class="formation-clear" href="/formacion/#resultados">Limpiar filtros</a>
      </div>
    </form>

    <section class="formation-results" aria-labelledby="resultados">
      <div class="formation-result-heading"><h2 id="resultados" tabindex="-1">Explora opciones de formación</h2><p id="formation-count" >Opciones: {resultRange(page)}</p></div>
      <div id="formation-list">
        {page.items.map(option => <article id={option.slug.replace('/', '--')} data-training-row>
          <a class="formation-row" href={trainingPath(option.center, option.isProgram ? option.slug.split('/')[1] : undefined)}>
            <span class="formation-card-icon"><GuideIcon kind={icons[option.type]} /></span>
            <header><h3>{option.title}</h3>{option.isProgram && <p>{option.name}</p>}<p class="formation-location"><img src="/icons/geo-alt.svg" alt="" width="16" height="16"/>{option.location}</p></header>
            <div class="formation-cost"><strong>{option.costLabel}</strong>{option.costNote && <p>{option.costNote}</p>}</div>
            <span class="formation-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></span>
          </a>
        </article>)}
      </div>
      <CatalogPagination page={page} anchor="resultados" label="Páginas de formación" />
      <div class="formation-empty" id="formation-empty" hidden={page.total > 0}><h3>No encontramos opciones con estos filtros</h3><p>La selección aún no cubre todos los departamentos. Prueba otra modalidad o consulta los directorios oficiales de la guía.</p><a href="/formacion/#resultados">Limpiar filtros</a><a href={`${trainingGuidePath}#directorios`}>Buscar en directorios oficiales →</a></div>
    </section>
    <p class="formation-context">{programs.entries.length.toLocaleString('es-PE')} programas documentados en {centers.entries.length} instituciones y plataformas. Cuando la fuente solo registra el centro, puedes consultar su ficha. <a href={`${trainingGuidePath}#comparar`}>Cómo comparar costos y certificados →</a> · <a href="/guias/#formacion">Guías de formación y seguridad →</a></p>
    <aside class="formation-guide" aria-labelledby="formation-guide-title"><h2 id="formation-guide-title">Antes de elegir, compara bien.</h2><div><p>Costo completo, práctica y credencial: qué preguntar al centro.</p><a href={trainingGuidePath}>Leer la guía <span aria-hidden="true">↗</span></a></div><p>Datos de la guía · <time datetime="2026-10-26">26 oct 2026</time></p></aside>
    </section>
    <AdSlot slotId="formacion-side-2" size={{ w: 160, h: 600 }} media="(min-width: 1280px)" class="sticky top-24 hidden w-fit self-start xl:col-start-3 xl:row-start-1 xl:block" />
  </div>
  <AdSlot slotId="formacion-bottom-desktop-1" size={{ w: 970, h: 90 }} media="(min-width: 1024px)" class="mx-auto w-fit hidden lg:block" />
  <AdSlot slotId="formacion-bottom-mobile-1" size={{ w: 320, h: 100 }} media="(max-width: 1023.98px)" class="mx-auto w-fit lg:hidden" />
</Layout>
<script>
  import '../scripts/formation';
</script>
