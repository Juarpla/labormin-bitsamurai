---
import Layout from '../../layouts/Layout.astro';
import JobDetailView from '../../components/pages/JobDetailView.astro';
import { allJobs, archivedJobs, locationLine, titleFor } from '../../lib/jobs';
import { useTranslations } from '../../lib/i18n';
import { isPublicClosure } from '../../lib/job-archive.mjs';

export function getStaticPaths() {
  const excerptKey = (excerpt: string) => excerpt.trim().replace(/\s+/g, ' ').toLowerCase();
  const excerptCounts = new Map<string, number>();
  for (const job of allJobs) {
    const key = excerptKey(job.excerpt);
    excerptCounts.set(key, (excerptCounts.get(key) ?? 0) + 1);
  }
  const t = useTranslations('es');
  return [
    ...allJobs.map(job => {
      const title = titleFor(job, 'es');
      const key = excerptKey(job.excerpt);
      const description = key && excerptCounts.get(key) === 1
        ? job.excerpt
        : `${title} en ${job.company} · ${locationLine(job, t)}. Consulta los requisitos y cómo postular.`;
      return { params: { slug: job.slug }, props: { job, archive: null, title, description, noindex: false } };
    }),
    ...archivedJobs.map(archive => ({
      params: { slug: archive.slug },
      props: {
        job: archive.snapshot, archive, title: archive.snapshot ? titleFor(archive.snapshot, 'es') : archive.title,
        description: `${archive.title} en ${archive.company}. Consulta esta ficha histórica y encuentra convocatorias vigentes en Labormin.`,
        noindex: !isPublicClosure(archive),
      },
    })),
  ];
}
const { job, archive, title, description, noindex } = Astro.props;
const slug = job?.slug ?? archive?.slug;
---
<Layout title={`${title} — ${job?.company ?? archive?.company} | Labormin`} description={description} path={`/jobs/${slug}`} noindex={noindex} ads={false}>
  {job ? <JobDetailView job={job} archive={archive} /> : archive && <article data-archived-job class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold text-brand-400">{archive.reason === 'stale' || archive.reason === 'expired' ? 'Convocatoria finalizada' : 'Oferta fuera del catálogo activo'}</p>
    <h1 class="mt-4 font-display text-3xl font-semibold leading-tight text-graphite-100">{archive.title}</h1>
    <p class="mt-4 text-lg text-graphite-200">{archive.company}</p>
    <p class="mt-6 max-w-prose leading-relaxed text-graphite-200">Esta ficha conserva la información disponible de la convocatoria anterior. Consulta el catálogo para encontrar vacantes vigentes.</p>
    <p class="mt-4 text-sm text-graphite-400">Fecha de referencia: {archive.referenceDate}. Retirada del catálogo: {archive.removedAt}.</p>
    <a href="/jobs/" class="mt-8 inline-block rounded-full bg-brand-500 px-5 py-3 text-sm font-semibold text-graphite-950">Ver ofertas vigentes</a>
  </article>}
</Layout>
