---
import Layout from '../../layouts/Layout.astro';
import JobDetailView from '../../components/pages/JobDetailView.astro';
import JobUnavailableView from '../../components/pages/JobUnavailableView.astro';
import { allJobs, locationLine, titleFor } from '../../lib/jobs';
import { useTranslations } from '../../lib/i18n';
import { catalogRecord, openCatalog } from '../../lib/catalog';
import { catalogNow, isActiveJobRow } from '../../lib/catalog-data';
import { isExpired } from '../../lib/job-policy.mjs';
import type { Job } from '../../schemas';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const now = catalogNow();
const at = now.toISOString();
const entry = await catalogRecord('jobs', slug);
const candidate = entry?.payload.job;
const job = entry && candidate && isActiveJobRow(entry.metadata, at) && !isExpired(candidate, now) ? candidate : null;
const path = `/jobs/${encodeURIComponent(slug)}`;
let title = 'Convocatoria no disponible | Labormin';
let description = 'Consulta las ofertas de empleo y prácticas vigentes en Labormin.';
let alternatives: Job[] = [];
let guidancePool: Job[] = [];

if (job && entry) {
  const candidateType = job.internship && job.country === 'PE' ? 'internship' : 'job';
  const catalog = await openCatalog('jobs', undefined, at);
  const active = catalog.entries.filter(item => isActiveJobRow(item.metadata, at));
  const activeSlugs = new Set(active.map(item => item.slug));
  guidancePool = allJobs.filter(item => activeSlugs.has(item.slug));
  const sameType = active.filter(item => item.metadata.type === candidateType);
  const { excerptKey } = entry.metadata;
  const name = titleFor(job, 'es');
  title = `${name} — ${job.company} | Labormin`;
  description = excerptKey && sameType.filter(item => item.metadata.excerptKey === excerptKey).length === 1
    ? job.excerpt
    : `${name} en ${job.company} · ${locationLine(job, useTranslations('es'))}. Consulta los requisitos y cómo postular.`;
  const candidates = sameType.filter(item => item.slug !== slug &&
    (candidateType === 'internship' || item.metadata.country === job.country || item.metadata.category === job.category));
  if (candidateType === 'internship') {
    const relevance = ({ metadata }: typeof candidates[number]) => 2 * Number(job.category !== 'other' && metadata.category === job.category) + Number(metadata.country === job.country);
    candidates.sort((a, b) => relevance(b) - relevance(a));
  }
  alternatives = (await catalog.read(candidates.slice(0, 10).map(item => item.slug)))
    .flatMap(row => row.job && !isExpired(row.job, now) ? [row.job] : []);
} else {
  Astro.response.status = 404;
}
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Layout title={title} description={description} path={path} noindex={!job} ads={false}>
  {job ? <JobDetailView job={job} relatedPool={alternatives} guidancePool={guidancePool} clearView={entry?.payload.clearView} now={now} /> : <JobUnavailableView />}
</Layout>
