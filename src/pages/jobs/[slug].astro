---
import Layout from '../../layouts/Layout.astro';
import JobDetailView from '../../components/pages/JobDetailView.astro';
import JobUnavailableView from '../../components/pages/JobUnavailableView.astro';
import { locationLine, titleFor } from '../../lib/jobs';
import { useTranslations } from '../../lib/i18n';
import { openJobDetail } from '../../lib/catalog';
import { catalogNow } from '../../lib/catalog-data';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const now = catalogNow();
const detail = await openJobDetail(slug, now);
const path = `/jobs/${encodeURIComponent(slug)}`;
let title = 'Convocatoria no disponible | Labormin';
let description = 'Consulta las ofertas de empleo y prácticas vigentes en Labormin.';

if (detail) {
  const { job } = detail;
  const name = titleFor(job, 'es');
  title = `${name} — ${job.company} | Labormin`;
  description = detail.uniqueExcerpt
    ? job.excerpt
    : `${name} en ${job.company} · ${locationLine(job, useTranslations('es'))}. Consulta los requisitos y cómo postular.`;
  if (detail.rowsRead !== undefined) {
    Astro.response.headers.append('Server-Timing', `d1-job;desc="${detail.rowsRead} rows read"`);
  }
} else {
  Astro.response.status = 404;
}
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Layout title={title} description={description} path={path} noindex={!detail} ads={false}>
  {detail ? <JobDetailView job={detail.job} related={detail.related} guidancePool={detail.guidance} clearView={detail.clearView} now={now} /> : <JobUnavailableView />}
</Layout>
