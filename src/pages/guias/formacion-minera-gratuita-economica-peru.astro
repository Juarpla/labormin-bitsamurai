---
import GuideLayout from '../../layouts/GuideLayout.astro';
import TrainingGraphic from '../../components/guides/TrainingGraphic.astro';
import GuideIcon from '../../components/guides/GuideIcon.astro';
import TrainingOption from '../../components/guides/TrainingOption.astro';
import TrainingNotes from '../../components/guides/TrainingNotes.astro';
import options from '../../data/education.json';
import '../../styles/training-guide.css';
const groups = [
  {id:'cursos' as const, label:'Un curso', aim:'Refuerza una habilidad', title:'Empieza desde casa', intro:'Cursos gratuitos para sumar habilidades. Revisa cuáles necesita el puesto que buscas.', note:'Un curso no sustituye una carrera ni la inducción de una operación.'},
  {id:'oficios' as const, label:'Un oficio', aim:'Aprende con práctica', title:'Aprende haciendo', intro:'Electricidad, electrónica o dibujo técnico: busca un oficio cerca de ti.', note:'Formarte en un oficio industrial no acredita experiencia en mina.'},
  {id:'carreras' as const, label:'Una carrera', aim:'Construye una base técnica', title:'Piensa en varios años', intro:'Compara el costo completo, el plan y la credencial antes de trasladarte.', note:'Tres años de estudio no otorgan bachiller técnico automáticamente.'}
];
---
<GuideLayout visual title="Dónde estudiar para minería con poco presupuesto en Perú" description="Cursos gratuitos, CETPRO e institutos públicos: compara costos, duración y credenciales con fuentes oficiales." path="/guias/formacion-minera-gratuita-economica-peru">
  <header slot="hero" class="training-hero">
    <h1>Hay más de una forma<br class="hero-break"/> de <em>empezar.</em></h1>
    <div><p class="hero-deck">Dónde estudiar para minería con poco presupuesto en Perú.</p><p class="hero-byline">Investigación de Labormin · Bit SamurAI<br/>Fuentes: 26 de octubre de 2026</p></div>
  </header>
  <div class="training-guide">
    <section class="route-chooser" aria-labelledby="elige-ruta" data-training-chooser>
      <h2 id="elige-ruta">¿Qué quieres aprender?</h2>
      <nav class="training-map" aria-label="Alternativas de formación">
        {groups.map(group => <a href={`#${group.id}`}><TrainingGraphic kind={group.id}/><div><h3>{group.label}</h3><p>{group.aim}</p><span class="route-link">Explorar opciones <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v14m-5-5 5 5 5-5"/></svg></span></div></a>)}
      </nav>
      <span class="quiet-rule" aria-hidden="true"></span>
    </section>
    <aside class="budget-note" aria-labelledby="presupuesto"><div><h2 id="presupuesto">El costo va más allá<br/> de la matrícula.</h2><a href="#comparar">Qué preguntar antes de pagar ↗</a></div><ul><li><GuideIcon kind="materials"/><span>Materiales<br/>y herramientas</span></li><li><GuideIcon kind="travel"/><span>Transporte<br/>y alojamiento</span></li><li><GuideIcon kind="credential"/><span>Certificados<br/>y título</span></li></ul></aside>
    {groups.map(group => <section class:list={['training-chapter',`chapter-${group.id}`]} aria-labelledby={group.id}>
      <header class="chapter-heading"><div><h2 id={group.id}>{group.title}</h2><p>{group.intro}</p></div><p class="chapter-note">{group.note}</p></header>
      <div class="training-options">{options.filter(option => option.group === group.id).map(option => <TrainingOption option={option}/>)}</div>
    </section>)}
    <TrainingNotes/>
  </div>
</GuideLayout>
<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const chooser = document.querySelector('[data-training-chooser]');
  if (chooser) {
    const media = gsap.matchMedia();
    media.add('(prefers-reduced-motion: no-preference)', () => {
      gsap.fromTo(chooser.querySelector('.quiet-rule'), {scaleX:.12}, {
        scaleX:1, duration:.7, ease:'expo.out',
        scrollTrigger:{trigger:chooser, start:'top 85%', once:true}
      });
    });
    // Native disclosures can change section positions; no scroll is intercepted.
    document.querySelectorAll('.training-guide details').forEach(details => {
      details.addEventListener('toggle', () => ScrollTrigger.refresh());
    });
    document.fonts.ready.then(() => ScrollTrigger.refresh());
    window.addEventListener('pageshow', event => { if(event.persisted) ScrollTrigger.refresh(); });
  }
</script>
