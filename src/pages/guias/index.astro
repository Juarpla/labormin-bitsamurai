---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import GuideIcon from '../../components/guides/GuideIcon.astro';
import EditorialRoute from '../../components/guides/EditorialRoute.astro';
import { editorialGuides, guideGroups, visualGuides } from '../../lib/editorial-guides';

const guides = [...visualGuides, ...editorialGuides];
---
<Layout title="Guías para trabajar en minería — Labormin" description="Guías de Labormin para buscar tu primer empleo minero, elegir formación y evaluar las condiciones de una vacante en Perú." path="/guias/">
  <div class="xl:grid xl:grid-cols-[160px_56rem_160px] xl:justify-center xl:gap-4">
    <AdSlot slotId="guias-side-1" size={{w:160,h:600}} media="(min-width: 1280px)" class="sticky top-24 hidden w-fit self-start xl:col-start-1 xl:row-start-1 xl:block" />
    <div class="mx-auto w-full max-w-4xl min-w-0 px-4 py-12 sm:px-8 sm:py-16 xl:col-start-2 xl:row-start-1">
      <header class="grid items-center gap-5 sm:grid-cols-[1.25fr_1fr]">
        <div>
          <h1 class="text-balance font-display text-4xl font-semibold leading-tight text-graphite-100 sm:text-5xl">Guías para trabajar en minería</h1>
          <p class="mt-4 max-w-prose leading-relaxed text-graphite-200">Prepara tu primera postulación, elige dónde estudiar y confirma las condiciones de una oferta antes de aceptarla.</p>
        </div>
        <EditorialRoute steps={['Busca tu puesto', 'Refuerza habilidades', 'Compara ofertas']} />
      </header>

      <nav class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label="Temas de las guías">
        {guideGroups.map(group => <a class="text-brand-400 underline underline-offset-4 hover:text-brand-300" href={`#${group.id}`}>{group.title}</a>)}
      </nav>

      <AdSlot slotId="guias-top-1" size={{w:320,h:50}} media="(max-width: 1023.98px)" class="guide-mobile-ad mx-auto w-fit lg:hidden" />

      {guideGroups.map(group => <section class="mt-10 scroll-mt-32" id={group.id} aria-labelledby={`heading-${group.id}`}>
        <h2 id={`heading-${group.id}`} class="flex items-center gap-3 font-display text-2xl font-semibold text-graphite-100 sm:text-3xl">
          <span class="shrink-0 text-brand-400 [&_svg]:size-6"><GuideIcon kind={group.icon} /></span>
          {group.title}
        </h2>
        <ul class="mt-4 grid divide-y divide-graphite-800 border-y border-graphite-800" role="list">
          {guides.filter(guide => guide.group === group.id).map(guide => <li>
            <a href={`/guias/${guide.slug}/`} class="group grid grid-cols-[1fr_auto] items-start gap-4 rounded px-1 py-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-400">
              <div>
                <h3 class="font-semibold leading-snug text-graphite-100 transition-colors group-hover:text-brand-400">{guide.title}</h3>
                <p class="mt-1 max-w-prose text-sm leading-relaxed text-graphite-300">{guide.description}</p>
              </div>
              <svg viewBox="0 0 24 24" class="mt-0.5 size-4 text-brand-400" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg>
            </a>
          </li>)}
        </ul>
      </section>)}
    </div>
    <AdSlot slotId="guias-side-2" size={{w:160,h:600}} media="(min-width: 1280px)" class="sticky top-24 hidden w-fit self-start xl:col-start-3 xl:row-start-1 xl:block" />
  </div>
  <div class="pb-4">
    <AdSlot slotId="guias-bottom-desktop-1" size={{w:970,h:90}} media="(min-width: 1024px)" class="mx-auto w-fit hidden lg:block" />
    <AdSlot slotId="guias-bottom-mobile-1" size={{w:320,h:100}} media="(max-width: 1023.98px)" class="guide-mobile-ad mx-auto w-fit lg:hidden" />
  </div>
</Layout>
