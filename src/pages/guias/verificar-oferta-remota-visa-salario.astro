---
import GuideLayout from '../../layouts/GuideLayout.astro';
import OfferGraphic from '../../components/guides/OfferGraphic.astro';
import '../../styles/offer-guide.css';
const checks = [
  {id:'remoto' as const, title:'Desde dónde', text:'¿Puedes residir en Perú?', action:'Comprobar ubicación'},
  {id:'visa' as const, title:'Con qué permiso', text:'¿Qué apoyo declara la oferta?', action:'Distinguir las condiciones'},
  {id:'salario' as const, title:'Por cuánto', text:'¿Qué rango aplica a tu ubicación?', action:'Leer la remuneración'}
];
const locationCases = [
  {title:'Menciona Perú', text:'Comprueba que se refiera a tu residencia, no a un viaje del proyecto. Una mina en Perú no confirma que todo puesto remoto admita trabajar desde aquí.'},
  {title:'Dice «desde cualquier país»', text:'Lee las excepciones. «Equipo global» describe a la empresa; no confirma en qué países contrata.'},
  {title:'Limita los países', text:'Si solo admite residentes o personas autorizadas en otros países, no asumas que puedes trabajar desde Perú.'},
  {title:'No lo aclara', text:'Pregunta antes de invertir tiempo o dinero. Labormin excluye de «Remoto desde Perú» los casos sin evidencia suficiente.'}
];
const visaTerms = [
  {term:'Visa sponsorship available', meaning:'Posible patrocinio', check:'Confirma si cubre tu perfil, nacionalidad y situación. No garantiza contratación ni autorización.'},
  {term:'Must already be authorized to work', meaning:'Permiso laboral previo', check:'Pide que ya tengas autorización. La frase por sí sola no ofrece obtenerla para ti.'},
  {term:'Relocation assistance', meaning:'Ayuda para trasladarte', check:'Pregunta qué gastos cubre y si incluye trámites migratorios. No deduzcas patrocinio de visa.'},
  {term:'No sponsorship available', meaning:'Sin patrocinio en ese puesto', check:'Descarta patrocinio en esa vacante; no en todas las contrataciones de la empresa.'}
];
const payChecks = [
  {title:'Moneda y periodo', text:'El símbolo $ puede referirse a monedas distintas. Confirma si el importe es por hora, mes o año.'},
  {title:'Rango y límite', text:'«Hasta» indica un máximo; «desde», un mínimo. Ninguno asegura que cobrarás ese monto.'},
  {title:'Ubicación aplicable', text:'Un rango de Estados Unidos puede ser solo para quienes trabajan allí. No lo conviertas en una oferta para residentes en Perú.'},
  {title:'Base y beneficios', text:'Aclara si incluye bonos, acciones o viáticos. Si ves una errata o cifras incompatibles, pregunta; no corrijas mentalmente el anuncio.'}
];
---
<GuideLayout visual title="Cómo verificar una oferta: remoto, visa y salario" description="Comprueba si puedes trabajar desde Perú, qué apoyo migratorio declara una vacante y qué salario se aplica a tu ubicación." path="/guias/verificar-oferta-remota-visa-salario">
  <header slot="hero" class="offer-hero">
    <h1>¿Remoto desde Perú?<br/><em>Compruébalo.</em></h1>
    <div><p class="offer-deck">Cómo leer una oferta: ubicación, visa y salario, antes de postular.</p><p class="offer-byline">Investigación de Labormin · Bit SamurAI<br/>Fuentes: 26 de octubre de 2026</p></div>
  </header>
  <div class="offer-guide" data-offer-guide>
    <section class="offer-map" aria-labelledby="tres-comprobaciones">
      <h2 id="tres-comprobaciones">Tres preguntas que el anuncio debe resolver</h2>
      <nav aria-label="Comprobaciones de una oferta">
        {checks.map(check => <a href={`#${check.id}`}><OfferGraphic kind={check.id}/><div><h3>{check.title}</h3><p>{check.text}</p><span>{check.action} <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v14m-5-5 5 5 5-5"/></svg></span></div></a>)}
      </nav>
      <span class="offer-rule" aria-hidden="true"></span>
    </section>
    <p class="offer-opening">«Remote», «relocation assistance» y un salario en dólares dejan preguntas abiertas. Busca las respuestas en <strong>el anuncio original del empleador</strong>.</p>
    <section class="offer-chapter" aria-labelledby="remoto">
      <header class="offer-heading"><h2 id="remoto">Remoto también tiene una ubicación</h2><p>Revisa ubicación y requisitos hasta el final: las restricciones pueden aparecer en el último párrafo.</p></header>
      <aside class="search-terms"><h3>Palabras que conviene buscar</h3><p lang="en">location · eligible countries · based in · residency · work authorization</p></aside>
      <ul class="location-cases">{locationCases.map(item => <li><h3>{item.title}</h3><p>{item.text}</p></li>)}</ul>
      <details class="offer-example"><summary>Un caso real: el encabezado no cuenta todo</summary><p>La <a href="https://job-boards.greenhouse.io/koboldmetals/jobs/4677639005">vacante de Data Scientist de KoBold consultada el 26 de octubre de 2026</a> indicaba trabajo remoto, pero exigía autorización en una lista de países que no incluía Perú. Es una condición de esa vacante en esa fecha; no una conclusión sobre todas las contrataciones de la empresa.</p></details>
    </section>
    <section class="offer-chapter" aria-labelledby="visa">
      <header class="offer-heading"><h2 id="visa">Traslado, patrocinio y permiso son cosas distintas</h2><p>La señal de visa es reportada. Confirma con el empleador qué incluye y a quién se aplica.</p></header>
      <dl class="visa-terms">{visaTerms.map(item => <div><dt lang="en">{item.term}</dt><dd><strong>{item.meaning}</strong><p>{item.check}</p></dd></div>)}</dl>
      <aside class="official-note"><h3>Una solicitud no es un permiso de trabajo</h3><p><a href="https://on.jobbank.gc.ca/support/question?qaid=31&amp;tid=10">Job Bank</a> distingue las ofertas que aceptan solicitudes internacionales en Canadá. Aceptar tu solicitud no concede un permiso. Para Estados Unidos, consulta las <a href="https://www.uscis.gov/working-in-the-united-states">categorías y condiciones de USCIS</a>.</p><a class="next-link" href="/visa-pathways">Explorar rutas oficiales de visa <span aria-hidden="true">→</span></a><p class="small-note">Son un punto de partida: confirma requisitos vigentes en la autoridad del país.</p></aside>
    </section>
    <section class="offer-chapter" aria-labelledby="salario">
      <header class="offer-heading"><h2 id="salario">Desarma la cifra antes de compararla</h2><p>El salario es una condición que debes confirmar, no una promesa.</p></header>
      <ol class="pay-checks">{payChecks.map(item => <li><h3>{item.title}</h3><p>{item.text}</p></li>)}</ol>
      <details><summary>Cómo presenta Labormin las cifras</summary><p>Labormin muestra una cifra normalizada únicamente cuando puede interpretarla con suficiente claridad y permite consultar su redacción. Si faltan moneda, periodicidad o un rango coherente, consulta el anuncio original. Una cifra de producción, presupuesto o inversión de la empresa no es un salario.</p></details>
    </section>
    <section class="destination-check" aria-labelledby="documentos">
      <div><h2 id="documentos">Antes de enviar documentos</h2><p>Entra a empleo desde la web corporativa. Si usa una plataforma externa, comprueba que la empresa la enlace.</p></div>
      <ul><li>Contrasta puesto, ubicación, fecha y canal de contacto.</li><li>Desconfía de cobros por «reservar» un puesto, comprar contactos o garantizar contratación.</li><li>No compartas contraseñas, códigos ni datos bancarios con una identidad sin confirmar.</li></ul>
      <p class="destination-source">Más señales de engaño: <a href="https://consumer.ftc.gov/articles/job-scams">recomendaciones oficiales de la FTC sobre estafas de empleo</a>.</p>
    </section>
    <section class="employer-question" aria-labelledby="consulta">
      <h2 id="consulta">Pregunta con precisión</h2><p>Una consulta que puedes adaptar al empleador:</p>
      <blockquote>«Vivo en Perú. ¿Esta vacante permite trabajar desde aquí? ¿Exige autorización laboral previa en otro país? Si requiere mudanza, ¿incluye patrocinio migratorio o solamente apoyo de traslado? ¿Qué rango salarial se aplica a mi ubicación?»</blockquote>
      <p class="save-source">Guarda el enlace y la fecha de consulta. Si el anuncio cambia, revisa sus condiciones antes de aceptar o hacer un gasto. Puedes <a href="/contact">reportarnos una clasificación incorrecta</a> con el enlace y el fragmento de la fuente.</p>
    </section>
  </div>
</GuideLayout>
<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const guide = document.querySelector('[data-offer-guide]');
  if (guide) {
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      gsap.fromTo(guide.querySelector('.offer-rule'), {scaleX:.12}, {
        scaleX:1, duration:.7, ease:'expo.out',
        scrollTrigger:{trigger:guide.querySelector('.offer-map'),start:'top 85%',once:true}
      });
    });
    guide.querySelectorAll('details').forEach(details => details.addEventListener('toggle', () => ScrollTrigger.refresh()));
    document.fonts.ready.then(() => ScrollTrigger.refresh());
    window.addEventListener('pageshow', event => { if(event.persisted) ScrollTrigger.refresh(); });
  }
</script>
